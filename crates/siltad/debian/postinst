#!/bin/sh
# postinst for silta: users, directories, units. The daemon is enabled but not started
# on a first install (the configuration has no password yet); an upgrade restarts a
# running daemon. Session instances and their target are never started or restarted
# here: a session restart rewrites its whole context, so it stays a deliberate step
# (silta-session-add <name>, or systemctl restart silta-session.target).
set -e

case "$1" in
  configure)
    systemd-sysusers silta.conf
    systemd-tmpfiles --create silta.conf
    if [ -d /run/systemd/system ]; then
      systemctl --system daemon-reload >/dev/null || true
      for unit in siltad.service silta-backup.timer silta-session.target; do
        deb-systemd-helper unmask "$unit" >/dev/null || true
        if deb-systemd-helper --quiet was-enabled "$unit"; then
          deb-systemd-helper enable "$unit" >/dev/null || true
        else
          deb-systemd-helper update-state "$unit" >/dev/null || true
        fi
      done
      deb-systemd-invoke start silta-backup.timer >/dev/null || true
      if [ -n "$2" ]; then
        deb-systemd-invoke try-restart siltad.service >/dev/null || true
      else
        cat <<'NOTE'
Silta: next steps
  1. Install Claude Code once, as the claude user:
       sudo runuser -u claude -- bash -c "curl --proto '=https' --tlsv1.3 -fsSL https://claude.ai/install.sh | bash -s -- 2.1.283"
       (replace 2.1.283 with the tested version named in the Silta release notes).
  2. Install the packages for the md2pdf and research skills (PDF generation), otherwise they
     fail at use:
       sudo apt install pandoc fonts-dejavu fonts-noto-core fonts-noto-color-emoji
     and typst from the Silta release, or by hand from https://github.com/typst/typst
     (packaged with cargo-deb).
  3. Add a session for each person and "hub" if the assistant should join group rooms
     (the daemon refuses to start while a configured session's user does not exist):
       sudo silta-session-add <name>
  4. Give each session its credential, as silta-session-add prints: one file in
     /etc/silta/auth/<name>, oauth-token (claude setup-token) or api-key (Claude Console).
  5. Edit /etc/silta/siltad.toml: the homeserver, the assistant's password, the people, the sessions.
  6. Restart the Matrix daemon with the updated config:
       sudo systemctl restart siltad
  7. Enable and run each session, as instructed by silta-session-add in step 3:
       sudo systemctl enable --now silta-session@<name>
NOTE
      fi
    fi
    ;;
esac
exit 0
