#!/bin/sh
# postinst for silta: users, directories, units. The daemon is enabled but not started
# on a first install (the configuration has no password yet); an upgrade restarts a
# running daemon. Session instances and their target are never started or restarted
# here: a session restart rewrites its whole context, so it stays a deliberate step
# (silta-session-add <name>, or systemctl restart silta-session.target).
set -e

case "$1" in
  configure)
    systemd-sysusers silta.conf
    systemd-tmpfiles --create silta.conf
    if [ -d /run/systemd/system ]; then
      systemctl --system daemon-reload >/dev/null || true
      for unit in siltad.service silta-backup.timer silta-session.target; do
        deb-systemd-helper unmask "$unit" >/dev/null || true
        if deb-systemd-helper --quiet was-enabled "$unit"; then
          deb-systemd-helper enable "$unit" >/dev/null || true
        else
          deb-systemd-helper update-state "$unit" >/dev/null || true
        fi
      done
      deb-systemd-invoke start silta-backup.timer >/dev/null || true
      if [ -n "$2" ]; then
        deb-systemd-invoke try-restart siltad.service >/dev/null || true
      else
        cat <<'NOTE'
silta: next steps, as root
  1. install Claude Code once, as the claude user:
       runuser -u claude -- bash -c 'curl -fsSL https://claude.ai/install.sh | bash'
  2. silta-session-add hub, then silta-session-add <name> for each person
     (the daemon refuses to start while a configured session's user does not exist)
  3. give each mind its credential, as silta-session-add prints: one file in
     /etc/silta/auth/<name>, oauth-token (claude setup-token) or api-key (Claude Console)
  4. edit /etc/silta/siltad.toml: the homeserver, the bot's password, the people, the sessions
  5. systemctl start siltad
  6. for the md2pdf and research skills (PDF generation), otherwise they fail at use:
       apt install pandoc fonts-dejavu fonts-noto-core fonts-noto-color-emoji
     and typst by hand from https://github.com/typst/typst (packaged with cargo-deb).
NOTE
      fi
    fi
    ;;
esac
exit 0
