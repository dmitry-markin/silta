#!/bin/sh
# prerm for silta: on removal, stop every session instance (PartOf the target, so the
# target's stop reaches them), the timer and the daemon.
set -e
if [ "$1" = remove ] && [ -d /run/systemd/system ]; then
  deb-systemd-invoke stop silta-session.target silta-backup.timer siltad.service >/dev/null || true
fi
exit 0
