#!/usr/bin/env bash
# Runs one Silta session headless for silta-session@<name>.service.
#
# From the unit: SILTA_SESSION (the instance name), HOME (the state directory), the
# credential oauth-token, and the pins SILTA_MODEL, SILTA_EFFORT, SILTA_FALLBACK_MODEL.
# Overridable: SILTA_SOCKET, SILTA_PERSONA, SILTA_CLAUDE_BIN, SILTA_SESSION_LOG,
# CLAUDE_BIN. The workspace is $HOME/workspace with inbox/ and out/. The session id is
# chosen here on the first start (--session-id), saved in $HOME/session-id and resumed
# afterwards as long as its transcript exists under $HOME/.claude/projects. Claude
# Code's stdout (stream-json) goes through silta-session-log to the journal: the
# operational lines stay, the conversation's texts do not. Its stderr goes to the
# journal and to $HOME/session.err (truncated at every start), which decides after an
# exit whether the saved id can still be resumed.
#
# stdin is a FIFO this script holds open, one initial user message
# starts the first turn, channel events arrive as turns; closing the FIFO ends the
# session cleanly.
set -euo pipefail
: "${SILTA_SESSION:?SILTA_SESSION must be set}"
state="${HOME:?HOME must be the state directory of the session}"
workspace="$state/workspace"
persona="${SILTA_PERSONA:-/etc/silta/persona.md}"
claude_bin="${CLAUDE_BIN:-/opt/claude/.local/bin/claude}"
log_filter="${SILTA_SESSION_LOG:-/usr/lib/silta/silta-session-log}"
export SILTA_CLAUDE_BIN="${SILTA_CLAUDE_BIN:-/usr/bin/silta-claude}"
export SILTA_SOCKET="${SILTA_SOCKET:-/run/siltad/siltad.sock}"
export SILTA_INBOX="$workspace/inbox"
export DISABLE_AUTOUPDATER=1

if [ -n "${CREDENTIALS_DIRECTORY:-}" ] && [ -r "$CREDENTIALS_DIRECTORY/oauth-token" ]; then
  CLAUDE_CODE_OAUTH_TOKEN=$(tr -d '[:space:]' < "$CREDENTIALS_DIRECTORY/oauth-token")
  export CLAUDE_CODE_OAUTH_TOKEN
else
  echo "no oauth-token credential: the session cannot authenticate (see /etc/silta/oauth-token)" >&2
fi

mkdir -p "$workspace/inbox" "$workspace/out"
cd "$workspace"
fifo="$state/session.fifo"
[ -p "$fifo" ] || mkfifo -m 0600 "$fifo"
idfile="$state/session-id"
errfile="$state/session.err"
# Claude Code keeps one log file per start of an MCP server and never removes them.
find "$state/.cache/claude-cli-nodejs" -type f -mtime +30 -delete 2>/dev/null || true

# The prompt-less form; --channels last because it is variadic.
args=(-p --input-format stream-json --output-format stream-json --verbose
      --permission-mode auto --permission-prompts none
      --append-system-prompt-file "$persona")
[ -n "${SILTA_MODEL:-}" ] && args+=(--model "$SILTA_MODEL")
[ -n "${SILTA_EFFORT:-}" ] && args+=(--effort "$SILTA_EFFORT")
[ -n "${SILTA_FALLBACK_MODEL:-}" ] && args+=(--fallback-model "$SILTA_FALLBACK_MODEL")
id=""
[ -s "$idfile" ] && id=$(tr -d '[:space:]' < "$idfile")
resumed=0
if [ -n "$id" ] && compgen -G "$state/.claude/projects/*/$id.jsonl" > /dev/null; then
  args+=(--resume "$id")
  resumed=1
  echo "resuming session $id" >&2
else
  [ -n "$id" ] && echo "session $id has no transcript under $state/.claude/projects; starting a new one" >&2
  id=$(cat /proc/sys/kernel/random/uuid)
  echo "$id" > "$idfile"
  args+=(--session-id "$id" --name "silta-$SILTA_SESSION")
  echo "new session $id" >&2
fi
args+=(--channels plugin:silta-claude@silta-local)

# The message that starts the first turn: without one, no channel event is ever delivered
# at all. It is sent on every start, so a restart also seeds a turn in which the mind
# can notice a tool that broke while it was down. On a resume it lands in the middle of
# the existing conversation, which is why it names the host as its sender and says that
# nothing is waiting; the mind counts the earlier such lines in its own history when it
# needs to know how often it has restarted. Interpolated values must hold no quote and no
# backslash, because the JSON is assembled by hand below: the session name is
# [a-z][a-z0-9-]* from silta-session-add, the stamp is date's own output.
now=$(date -u '+%Y-%m-%d %H:%M')
if [ "$resumed" = 1 ]; then
  intro="Session $SILTA_SESSION restarted at $now UTC and resumed its history. You are connected to the family chat through the silta channel. This line comes from the host at every start, not from a person. If there is no work to do from before the session restart, end this turn and stay idle until a message arrives."
else
  intro="Session $SILTA_SESSION started at $now UTC: a new conversation, no history. You are connected to the family chat through the silta channel. This line comes from the host, not from a person, and no one is waiting on you yet, so use this turn to look around the workspace and check that your tools work. Bash commands run in a sandbox, so some paths and hosts are refused by design and that is not a fault. Then end the turn and stay idle until a message arrives."
fi
initial="{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":\"$intro\"}}"

: > "$errfile"
"$claude_bin" "${args[@]}" < "$fifo" > >(exec "$log_filter") 2> >(exec tee -a "$errfile" >&2) &
pid=$!
exec 3> "$fifo"
printf '%s\n' "$initial" >&3

stop() {
  exec 3>&-
  for _ in $(seq 1 150); do kill -0 "$pid" 2>/dev/null || exit 0; sleep 0.1; done
  echo "claude did not exit on stdin EOF within 15 s, killing it" >&2
  kill -9 "$pid" 2>/dev/null || true
}
trap stop INT TERM
code=0
wait "$pid" || code=$?
[ "$code" != 0 ] && echo "claude exited with $code" >&2
# Only a saved id that no longer resumes is dropped, so that a start that fails for any
# other reason (an expired token, the network) keeps the conversation.
if [ "$resumed" = 1 ] && grep -q "No conversation found with session ID" "$errfile"; then
  echo "session $id cannot be resumed; a new session starts on the next run" >&2
  rm -f "$idfile"
fi
exit "$code"
