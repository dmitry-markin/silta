#!/bin/sh
# The PreCompact hook (matcher "auto") of every mind, declared in
# /etc/claude-code/managed-settings.json: blocks Claude Code's automatic compaction and
# asks the supervisor for a rotation instead (docs/session-rotation-design.md). Runs as
# a child of claude, outside the Bash sandbox, with the unit's environment. stdin is a
# JSON object with session_id, transcript_path and trigger. Exit 2 blocks the
# compaction, and the line on stderr lands in the session's context. Outside a mind
# (no SILTA_SESSION: the owner's own sessions on a host with the packaged settings) the
# compaction is allowed, as it is when the marker cannot be written.
set -u
[ -n "${SILTA_SESSION:-}" ] || exit 0
state="${STATE_DIRECTORY:-$HOME}"
input=$(cat)
printf '%s\n' "$input" > "$state/rotate-requested.tmp" && mv "$state/rotate-requested.tmp" "$state/rotate-requested" || exit 0
echo "silta: automatic compaction blocked; the host rotates the session at the next quiet moment and asks for a handoff first" >&2
exit 2
