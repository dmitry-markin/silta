#!/usr/bin/python3 -I
"""The PreCompact hook (matcher "auto") of every mind, declared in
/etc/claude-code/managed-settings.json: blocks Claude Code's automatic compaction of the main
session and asks the supervisor for a rotation instead.

Runs as a child of claude, outside the Bash sandbox, with the unit's environment (hence -I:
no PYTHON* variables, no user site, not the script's directory on sys.path). stdin is a JSON
object with session_id, transcript_path and trigger, plus agent_id when the compaction is a
subagent's. Exit 2 blocks the compaction, and the line on stderr lands in the session's
context; exit 0 lets it proceed.

The compaction is allowed, and no marker is left:
- outside a mind (no SILTA_SESSION);
- when rotation is switched off for the mind (SILTA_ROTATE=0 in its unit, inherited from the
  supervisor);
- for a subagent, which compacts its own context, not the main session's; blocking it with
  the marker would rotate the main session. Claude Code sets agent_id only inside a subagent,
  never on the main thread (not even in an --agent session), and names it as the field that
  tells the two apart; agent_type does not, since the main thread of an --agent session has
  one too;
- when the marker cannot be written.

Input that is not a JSON object counts as the main session's: the marker is written and the
compaction blocked, so a mind never falls back to Claude Code's own compaction by mistake.
"""

import json
import os
import sys

MARKER = "rotate-requested"
OFF = {"0", "false", "no", "off"}


def is_subagent(data: bytes) -> bool:
    """Whether the hook input carries a top-level agent_id (any value but null)."""
    try:
        hook_input = json.loads(data)
    except ValueError:
        return False
    return isinstance(hook_input, dict) and hook_input.get("agent_id") is not None


def write_marker(state: str, content: bytes) -> bool:
    """Writes the marker through a temporary file and a rename, so the supervisor never
    reads half of it."""
    path = os.path.join(state, MARKER)
    tmp = path + ".tmp"
    try:
        with open(tmp, "wb") as f:
            f.write(content)
        os.replace(tmp, path)
    except OSError:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        return False
    return True


def main() -> int:
    if not os.environ.get("SILTA_SESSION"):
        return 0
    if os.environ.get("SILTA_ROTATE", "1").lower() in OFF:
        return 0

    data = sys.stdin.buffer.read()
    if is_subagent(data):
        return 0

    state = os.environ.get("STATE_DIRECTORY") or os.environ.get("HOME")
    if not state or not write_marker(state, data.rstrip(b"\n") + b"\n"):
        return 0

    print(
        "silta: automatic compaction blocked; the host rotates the session at the next quiet"
        " moment and asks for a handoff first",
        file=sys.stderr,
    )
    return 2


if __name__ == "__main__":
    sys.exit(main())
