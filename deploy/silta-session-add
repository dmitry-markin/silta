#!/usr/bin/env bash
# Adds one Silta session (a "mind") to this host:  silta-session-add <name>
#
# As root. Creates the system user silta-<name> in the silta group with
# /var/lib/silta/<name> as its home and the workspace below it, the empty credential
# directory /etc/silta/auth/<name>, registers the packaged
# marketplace and installs the silta-claude plugin at project scope as that user, and
# prints the [[sessions]] entry for /etc/silta/siltad.toml with the commands that put
# the mind to work. It touches no unit: enabling, starting and restarting
# silta-session@<name>.service stay the operator's, so a running mind is never
# interrupted behind their back.
#
# Running it again for an existing mind reinstalls the plugin. That is rarely what is
# needed: a session spawns the MCP server from ${SILTA_CLAUDE_BIN:-silta-claude} on PATH
# at every start, so a new /usr/bin/silta-claude only needs a restart of the unit. Only
# a change to the plugin's own marketplace files (.mcp.json above all) needs the
# reinstall, because Claude Code copies those into the user's plugin cache at install
# time and keeps running the copy. The reinstall takes effect when the operator restarts
# the unit.
set -euo pipefail
name="${1:-}"
if [ -z "$name" ] || ! [[ "$name" =~ ^[a-z][a-z0-9-]*$ ]]; then
  echo "usage: silta-session-add <name>    (lowercase letters, digits and hyphens: the session name in siltad.toml)" >&2
  exit 2
fi
[ "$(id -u)" = 0 ] || { echo "silta-session-add: run as root" >&2; exit 1; }
user="silta-$name"
home="/var/lib/silta/$name"
workspace="$home/workspace"
claude=/opt/claude/.local/bin/claude
marketplace=/usr/share/silta/marketplace
if [ ! -x "$claude" ]; then
  echo "silta-session-add: $claude is missing; install Claude Code once, as the claude user:" >&2
  echo "  runuser -u claude -- bash -c 'curl -fsSL https://claude.ai/install.sh | bash'" >&2
  exit 1
fi
auth="/etc/silta/auth/$name"

if getent passwd "$user" > /dev/null; then
  echo "user $user exists"
else
  useradd --system --home-dir "$home" --create-home --shell /usr/sbin/nologin --user-group --groups silta "$user"
  echo "created user $user with home $home"
fi
usermod -aG silta "$user"
chmod 0700 "$home"
chown "$user:$user" "$home"
install -d -m 0700 -o "$user" -g "$user" "$workspace" "$workspace/inbox" "$workspace/out"
# The mind's credential: root's, handed to the unit by systemd; the token is the operator's to add.
install -d -m 0700 -o root -g root /etc/silta/auth "$auth"

# As the session's user, with only what Claude Code needs in the environment.
as_user() { runuser -u "$user" -- env -i HOME="$home" PATH=/usr/bin:/bin DISABLE_AUTOUPDATER=1 "$@"; }
(
  cd "$workspace"
  as_user "$claude" plugin marketplace remove silta-local > /dev/null 2>&1 || true
  as_user "$claude" plugin marketplace add "$marketplace"
  as_user "$claude" plugin uninstall silta-claude@silta-local > /dev/null 2>&1 || true
  as_user "$claude" plugin install silta-claude@silta-local --scope project
)
echo "plugin silta-claude installed for $user in $workspace"

cat <<EOT

Give the daemon the session in /etc/silta/siltad.toml (a personal mind below; the hub
is receive = "groups"):

[[sessions]]
name = "$name"
receive = { people = ["<Person>"] }
user = "$user"

Give the mind its credential, exactly one file in $auth (the unit does not start
without): the person's subscription token, from claude setup-token under their account,

install -m 0600 /dev/stdin $auth/oauth-token

or their OpenRouter token (the endpoint is SILTA_GATEWAY_URL in the unit):

install -m 0600 /dev/stdin $auth/gateway-token

After this is done:

systemctl restart siltad
systemctl enable --now "silta-session@$name.service"
EOT
