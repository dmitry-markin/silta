# --------------------------------------------------------------------------------------------------
# The report: one line per check, the summary at the end.
# --------------------------------------------------------------------------------------------------

# syslog priorities, for the journal.
ERR, WARNING, NOTICE, INFO = 3, 4, 5, 6
# The terminal colour of each category of line (ANSI SGR codes: red, yellow, green, cyan).
COLORS = {"FAIL": "31", "WARN": "33", "PASS": "32", "SKIP": "36"}
PRIORITIES = {"FAIL": ERR, "WARN": WARNING}


def emit(
    text: str, priority: int = INFO, category: Optional[str] = None, out: Any = None, words: int = 1
) -> None:
    """Prints one or more lines. On a terminal the first `words` words are coloured after
    the `category` (a key of COLORS) unless NO_COLOR is set; under systemd, where stdout is
    the journal (JOURNAL_STREAM is set), each line gets the `<priority>` prefix journald
    reads and strips, so that failures show red in `journalctl` and `-p warning` lists them
    alone. An escape sequence in the journal would instead hide the whole line as
    `[blob data]`."""
    out = out or sys.stdout
    tty = hasattr(out, "isatty") and out.isatty()
    journal = not tty and "JOURNAL_STREAM" in os.environ
    color = COLORS.get(category or "")
    for line in text.split("\n"):
        if journal:
            if not line:
                continue
            line = f"<{priority}>{line}"
        elif tty and color and line and not os.environ.get("NO_COLOR"):
            head, rest = line.split(" ", words)[:words], line.split(" ", words)[words:]
            line = f"\033[{color}m{' '.join(head)}\033[0m" + (f" {rest[0]}" if rest else "")
        print(line, file=out, flush=True)


@dataclass
class Report:
    checks: list[tuple[str, str, str]] = field(default_factory=list)
    # What each run cost, in dollars as Claude Code counts it (list prices; notional on a
    # subscription); None for a run that was skipped.
    costs: dict[str, Optional[float]] = field(default_factory=dict)
    out: Any = sys.stdout
    # `--quiet`: PASS and INFO lines are counted but not printed.
    quiet: bool = False
    printed: int = 0

    def _add(self, status: str, name: str, detail: str) -> None:
        self.checks.append((status, name, detail))
        if self.quiet and status in ("PASS", "INFO"):
            return
        self.printed += 1
        line = f"{status:<5} {name}"
        if detail:
            line += f": {detail}"
        emit(line, PRIORITIES.get(status, INFO), status, self.out)

    def running(self, run: str, what: str) -> None:
        """A run starts: one line, not a check, so that a long run shows in the journal
        while it lasts (its checks print when it ends); left out by --quiet."""
        if not self.quiet:
            emit(f"RUN   {run}: {what}; its checks follow when it ends", out=self.out)

    def ok(self, name: str, detail: str = "") -> None:
        self._add("PASS", name, detail)

    def fail(self, name: str, detail: str) -> None:
        self._add("FAIL", name, detail)

    def skip(self, name: str, detail: str) -> None:
        self._add("SKIP", name, detail)

    def warn(self, name: str, detail: str) -> None:
        self._add("WARN", name, detail)

    def info(self, name: str, detail: str) -> None:
        self._add("INFO", name, detail)

    def check(self, name: str, condition: bool, detail: str, ok_detail: str = "") -> bool:
        """A pass or a fail, with the detail of the failure."""
        if condition:
            self.ok(name, ok_detail)
        else:
            self.fail(name, detail)
        return condition

    def failed(self) -> int:
        return sum(1 for status, _, _ in self.checks if status == "FAIL")

    def summary(self, version: Optional[str]) -> None:
        counts = {s: 0 for s in ("PASS", "FAIL", "SKIP", "WARN")}
        for status, _, _ in self.checks:
            if status in counts:
                counts[status] += 1
        emit(
            ("\n" if self.printed else "")
            + f"{counts['PASS']} passed, {counts['FAIL']} failed, {counts['SKIP']} skipped, "
            f"{counts['WARN']} warnings",
            NOTICE,
            out=self.out,
        )
        if self.costs:
            parts = ", ".join(
                f"{run} {'skipped' if usd is None else f'${usd:.2f}'}"
                for run, usd in self.costs.items()
            )
            emit(
                f"run cost: ${sum(usd or 0.0 for usd in self.costs.values()):.2f} ({parts})",
                NOTICE,
                out=self.out,
            )
        if self.failed():
            emit("contract broken:", ERR, "FAIL", self.out, words=2)
            for status, name, detail in self.checks:
                if status == "FAIL":
                    emit(f"  {name}: {detail}", ERR, out=self.out)
        elif version:
            if version in TESTED_VERSIONS:
                emit(
                    f"contract holds for Claude Code {version}, which is in TESTED_VERSIONS",
                    NOTICE,
                    "PASS",
                    self.out,
                    words=2,
                )
            else:
                emit(
                    f"contract holds for Claude Code {version}: add it to TESTED_VERSIONS in "
                    "crates/silta-session/src/contract.rs, to this script and to the README "
                    "(the supervisor prints a contract line at every turn until then)",
                    NOTICE,
                    "PASS",
                    self.out,
                    words=2,
                )


# --------------------------------------------------------------------------------------------------
# The trace: everything a run produced, in order, one dict per event. Claude Code's own
# stdout lines keep their `type`; the checker's entries have a `type` starting with `_`.
# Live runs write it and assert on it; `--replay` reads it back.
# --------------------------------------------------------------------------------------------------


class Trace:
    def __init__(self, path: Optional[Path] = None):
        self.lines: list[dict] = []
        self.lock = threading.Condition()
        self.path = path
        self.file = path.open("w", encoding="utf-8") if path else None
        self.started = time.monotonic()

    def add(self, entry: dict) -> None:
        with self.lock:
            entry.setdefault("_t", round(time.monotonic() - self.started, 3))
            self.lines.append(entry)
            if self.file:
                self.file.write(json.dumps(entry, ensure_ascii=False) + "\n")
                self.file.flush()
            self.lock.notify_all()

    def wait(self, pred: Callable[[dict], bool], timeout: float, start: int = 0) -> Optional[dict]:
        """The first entry from index `start` on satisfying `pred`, waiting up to `timeout`."""
        deadline = time.monotonic() + timeout
        with self.lock:
            i = start
            while True:
                while i < len(self.lines):
                    if pred(self.lines[i]):
                        return self.lines[i]
                    i += 1
                left = deadline - time.monotonic()
                if left <= 0:
                    return None
                self.lock.wait(left)

    def wait_quiet(self, quiet: float, timeout: float) -> bool:
        """Waits until no entry has arrived for `quiet` seconds and the last stdout line is
        a `result`; false when `timeout` passes first."""
        deadline = time.monotonic() + timeout
        with self.lock:
            while True:
                n = len(self.lines)
                last = next(
                    (line for line in reversed(self.lines) if not line["type"].startswith("_")),
                    None,
                )
                self.lock.wait(quiet)
                if len(self.lines) == n and last is not None and last["type"] == "result":
                    return True
                if time.monotonic() > deadline:
                    return False

    def __len__(self) -> int:
        with self.lock:
            return len(self.lines)

    def close(self) -> None:
        if self.file:
            self.file.close()
            self.file = None

    @staticmethod
    def load(path: Path) -> "Trace":
        trace = Trace()
        with path.open(encoding="utf-8") as f:
            for line in f:
                line = line.strip()
                if line:
                    trace.lines.append(json.loads(line))
        return trace


def session_cost(trace: Trace) -> float:
    """What the session cost so far, from its last `result` line: `total_cost_usd` is
    cumulative over the session, so a run that resumes one continues the count."""
    return max(
        (
            line.get("total_cost_usd", 0)
            for line in trace.lines
            if line.get("type") == "result" and isinstance(line.get("total_cost_usd"), (int, float))
        ),
        default=0.0,
    )


def note_cost(report: Report, name: str, trace: Trace) -> None:
    cost = session_cost(trace)
    if name == "resume":
        cost = max(cost - (report.costs.get("main") or 0.0), 0.0)
    report.costs[name] = cost


def stdout_lines(trace: Trace) -> list[dict]:
    return [line for line in trace.lines if not line["type"].startswith("_")]


def of_type(lines: list[dict], kind: str, subtype: Optional[str] = None) -> list[dict]:
    return [
        line
        for line in lines
        if line.get("type") == kind and (subtype is None or line.get("subtype") == subtype)
    ]


def is_main(line: dict) -> bool:
    """A line of the main conversation rather than a subagent's (stream.rs `subagent`)."""
    return line.get("parent_tool_use_id") is None


def content_text(line: dict) -> Optional[str]:
    """The text of a `user` line: a string, or the first text block (stream.rs `person_of`)."""
    content = line.get("message", {}).get("content")
    if isinstance(content, str):
        return content
    if isinstance(content, list):
        for block in content:
            if isinstance(block, dict) and isinstance(block.get("text"), str):
                return block["text"]
    return None


def all_text(line: dict) -> str:
    """Every text of a `user` line, joined: messages Claude Code queued during a turn may
    share one line."""
    content = line.get("message", {}).get("content")
    if isinstance(content, str):
        return content
    if isinstance(content, list):
        return "\n".join(
            block["text"]
            for block in content
            if isinstance(block, dict) and isinstance(block.get("text"), str)
        )
    return ""


def channel_tags(line: dict) -> list[dict[str, str]]:
    """The attributes of every `<channel ...>` tag in a `user` line."""
    return [
        dict(re.findall(r'([A-Za-z_][A-Za-z0-9_]*)="([^"]*)"', attrs))
        for attrs in re.findall(r"<channel\s([^>]*)>", all_text(line))
    ]


def find_delivery(lines: list[dict], event_id: str) -> tuple[Optional[int], dict, dict]:
    """The index of the `user` line that delivered the event, the line and its tag's
    attributes; (None, {}, {}) when the event never arrived."""
    for i, line in enumerate(lines):
        if line.get("type") != "user":
            continue
        for tag in channel_tags(line):
            if tag.get("event_id") == event_id:
                return i, line, tag
    return None, {}, {}


def sent_at(trace: Trace, event_id: str) -> Optional[int]:
    """The trace index at which the fake daemon sent the event."""
    return next(
        (
            i
            for i, line in enumerate(trace.lines)
            if line["type"] == "_daemon"
            and line.get("event") == "sent"
            and line.get("line", {}).get("event", {}).get("event_id") == event_id
        ),
        None,
    )


def stdin_at(trace: Trace, text: str) -> Optional[int]:
    """The trace index at which the host line `text` was written."""
    return next(
        (
            i
            for i, line in enumerate(trace.lines)
            if line["type"] == "_stdin"
            and line.get("line", {}).get("message", {}).get("content") == text
        ),
        None,
    )


def result_text(block: dict) -> str:
    """The text of a `tool_result` block."""
    content = block.get("content")
    if isinstance(content, str):
        return content
    if isinstance(content, list):
        return "\n".join(
            b.get("text", "") for b in content if isinstance(b, dict) and b.get("type") == "text"
        )
    return ""


def find_tool_result(lines: list[dict], tool_use_id: str) -> tuple[Optional[int], dict]:
    """The index of the `user` line answering a tool call, and its `tool_result` block."""
    for i, line in enumerate(lines):
        if line.get("type") == "user":
            for block in tool_results(line):
                if block.get("tool_use_id") == tool_use_id:
                    return i, block
    return None, {}


def main_tool_uses(lines: list[dict], names: tuple[str, ...]) -> list[tuple[int, dict]]:
    """The main line's calls of the named tools, with the index of their line."""
    return [
        (i, use)
        for i, line in enumerate(lines)
        if line.get("type") == "assistant" and is_main(line)
        for use in tool_uses(line)
        if use.get("name") in names
    ]


def session_slug(path: Path) -> str:
    """The directory name Claude Code files a workspace's transcripts and caches under."""
    return re.sub(r"[^A-Za-z0-9]", "-", str(path))


def channel_origin(line: dict) -> bool:
    """The `origin` Claude Code puts on a channel delivery's replayed `user` line and on
    the `result` of the turn it started (stream.rs `channel_origin`)."""
    return isinstance(line.get("origin"), dict) and line["origin"].get("kind") == "channel"


def tool_uses(line: dict) -> list[dict]:
    content = line.get("message", {}).get("content")
    if not isinstance(content, list):
        return []
    return [b for b in content if isinstance(b, dict) and b.get("type") == "tool_use"]


def tool_results(line: dict) -> list[dict]:
    content = line.get("message", {}).get("content")
    if not isinstance(content, list):
        return []
    return [b for b in content if isinstance(b, dict) and b.get("type") == "tool_result"]


def shorten(text: Any, n: int = 200) -> str:
    flat = " ".join(str(text).split())
    return flat if len(flat) <= n else flat[:n] + "…"


def trace_file(trace: Trace, name: str) -> Optional[dict]:
    """The `_file` entry the run recorded under `name`."""
    return next(
        (line for line in trace.lines if line["type"] == "_file" and line.get("name") == name),
        None,
    )


def report_stderr(report: Report, pre: str, trace: Trace) -> None:
    """For the record: what Claude Code wrote to stderr, which the supervisor passes to the
    journal as it is."""
    stderr = [
        line["text"] for line in trace.lines if line["type"] == "_stderr" and line["text"].strip()
    ]
    if stderr:
        report.info(
            pre + "stderr",
            " | ".join(shorten(s, 160) for s in stderr[:5])
            + (f" (+{len(stderr) - 5})" if len(stderr) > 5 else ""),
        )


def report_line_kinds(report: Report, lines: list[dict]) -> None:
    """For the record: every `type/subtype` the run produced, to diff between versions;
    stream.rs summarises the unknown ones by name."""
    kinds = sorted(
        {
            f"{line.get('type')}{'/' + str(line.get('subtype')) if line.get('subtype') else ''}"
            for line in lines
            if line.get("type") != "stream_event"
        }
    )
    report.info("main: line kinds", ", ".join(kinds))


# --------------------------------------------------------------------------------------------------
# The configuration: where things are and the values of the unit.
# --------------------------------------------------------------------------------------------------


@dataclass
class Config:
    claude: Path
    plugin_bin: Path
    marketplace: Path
    hook: Path
    filler: Path
    managed_settings: Path
    home: Path
    state: Path
    logs: Path
    service: bool
    auth_env: dict[str, str]
    model: str
    effort: str
    fallback_model: Optional[str]
    window: int
    stop_grace: int
    passthrough: dict[str, str]
    hook_model: str
    turn_timeout: float
    skip: set[str]
    keep: bool
    # Added to every run of Claude Code, with {logs} and {run} filled in (--claude-arg).
    claude_args: list[str]


def parse_unit(path: Path) -> dict[str, str]:
    """The `Environment=KEY=VALUE` lines of the session unit: the knobs a mind runs with."""
    env: dict[str, str] = {}
    if not path.is_file():
        return env
    for line in path.read_text(encoding="utf-8").splitlines():
        m = re.match(r"^Environment=([A-Z_][A-Z0-9_]*)=(.*)$", line.strip())
        if m and m.group(1) in UNIT_KEYS:
            env[m.group(1)] = m.group(2).strip().strip('"')
    return env


def load_credential(directory: Path) -> dict[str, str]:
    """The mind's credential layout (lib.rs `Auth::load`): exactly one of `auth_oauth-token`
    and `auth_api-key` in the credentials directory systemd fills from
    /etc/silta/auth/<name>. A gateway token is refused: Claude Code has no channels there."""
    found = {}
    for name in ("oauth-token", "api-key", "gateway-token"):
        p = directory / f"auth_{name}"
        if p.is_file():
            token = "".join(p.read_text(encoding="utf-8").split())
            if token:
                found[name] = token
    if not found:
        raise SystemExit(f"no credential in {directory}: expected auth_oauth-token or auth_api-key")
    if len(found) > 1:
        raise SystemExit(f"more than one credential in {directory}: keep one of {sorted(found)}")
    ((name, token),) = found.items()
    if name == "oauth-token":
        return {"CLAUDE_CODE_OAUTH_TOKEN": token}
    if name == "api-key":
        return {"ANTHROPIC_API_KEY": token}
    raise SystemExit(
        "a gateway-token: Claude Code offers no channels through a gateway, so there is nothing to"
        " check"
    )


def find_claude(explicit: Optional[str]) -> Path:
    for candidate in [
        explicit,
        os.environ.get("CLAUDE_BIN"),
        shutil.which("claude"),
        "/opt/claude/.local/bin/claude",
    ]:
        if candidate and Path(candidate).exists():
            return Path(candidate)
    raise SystemExit("claude not found: pass --claude or set CLAUDE_BIN")


def find_plugin_bin(explicit: Optional[str], repo: Optional[Path]) -> Path:
    candidates = [explicit, os.environ.get("SILTA_CLAUDE_BIN")]
    if repo:
        candidates += [repo / "target/release/silta-claude", repo / "target/debug/silta-claude"]
    candidates += [shutil.which("silta-claude"), "/usr/bin/silta-claude"]
    for candidate in candidates:
        if candidate and Path(candidate).is_file():
            return Path(candidate)
    raise SystemExit("silta-claude not found: pass --plugin-bin, set SILTA_CLAUDE_BIN, or build it")


def repo_root() -> Optional[Path]:
    """The repository this script is run from, if it is (deploy/silta-contract-check)."""
    here = Path(__file__).resolve().parent
    if here.name == "deploy" and (here.parent / "Cargo.toml").is_file():
        return here.parent
    return None


def configure(args: argparse.Namespace) -> Config:
    if os.geteuid() == 0:
        raise SystemExit(
            "do not run as root: on a VM use `systemctl start silta-contract-check`, which runs it"
            " as silta-check"
        )
    repo = repo_root()
    here = Path(__file__).resolve().parent
    credentials = args.credentials or os.environ.get("CREDENTIALS_DIRECTORY")
    service = credentials is not None
    home = Path(args.home or os.environ.get("HOME") or pwd.getpwuid(os.getuid()).pw_dir)
    if service:
        auth_env = load_credential(Path(credentials))
        state = Path(os.environ.get("STATE_DIRECTORY") or home)
        for sub in ("workspace",):
            (state / sub).mkdir(parents=True, exist_ok=True)
    else:
        if args.home:
            raise SystemExit("--home needs --credentials: an isolated HOME has no login of its own")
        auth_env = {}
        state = Path(tempfile.mkdtemp(prefix="silta-contract-check-"))
    unit = (
        Path(args.unit)
        if args.unit
        else (
            repo / "deploy/silta-session@.service"
            if repo
            else Path("/usr/lib/systemd/system/silta-session@.service")
        )
    )
    unit_env = parse_unit(unit)
    model = args.model or unit_env.get("SILTA_MODEL")
    if not model:
        raise SystemExit(
            "no model: pass --model or point --unit at a silta-session@.service with SILTA_MODEL"
            f" ({unit} has none)"
        )
    window = int(args.window or unit_env.get("CLAUDE_CODE_AUTO_COMPACT_WINDOW") or 0)
    if not window:
        raise SystemExit(
            "no window: pass --window or point --unit at a unit with"
            " CLAUDE_CODE_AUTO_COMPACT_WINDOW"
        )
    passthrough = {
        k: v
        for k, v in unit_env.items()
        if k in ("CLAUDE_CODE_DISABLE_REFUSAL_FALLBACK", "CLAUDE_CODE_SUBAGENT_MODEL")
    }
    marketplace = (
        Path(args.marketplace)
        if args.marketplace
        else (repo / "assistant/marketplace" if repo else Path("/usr/share/silta/marketplace"))
    )
    logs = Path(args.logs) if args.logs else state / "logs" / time.strftime("%Y-%m-%dT%H-%M-%S")
    logs.mkdir(parents=True, exist_ok=True)
    # The service keeps the traces of the last few runs.
    if service and not args.logs:
        for old in sorted(logs.parent.iterdir())[:-5]:
            shutil.rmtree(old, ignore_errors=True)
    return Config(
        claude=find_claude(args.claude),
        plugin_bin=find_plugin_bin(args.plugin_bin, repo),
        marketplace=marketplace,
        hook=here / "silta-precompact-block",
        filler=next(
            (
                p
                for p in (here / FILLER_FILE, Path("/usr/share/silta") / FILLER_FILE)
                if p.is_file()
            ),
            here / FILLER_FILE,
        ),
        managed_settings=Path("/etc/claude-code/managed-settings.json"),
        home=home,
        state=state,
        logs=logs,
        service=service,
        auth_env=auth_env,
        model=model,
        effort=args.effort or "low",
        fallback_model=args.fallback_model or unit_env.get("SILTA_FALLBACK_MODEL"),
        window=window,
        stop_grace=int(unit_env.get("SILTA_STOP_GRACE") or 120),
        passthrough=passthrough,
        hook_model=args.hook_model,
        turn_timeout=args.turn_timeout,
        skip=set(filter(None, (args.skip or "").split(","))),
        keep=args.keep,
        claude_args=(
            args.claude_arg
            if args.claude_arg is not None
            else shlex.split(os.environ.get("SILTA_CHECK_CLAUDE_ARGS", ""))
        ),
    )


def base_env(cfg: Config) -> dict[str, str]:
    """The environment Claude Code and the plugin commands run with. Every `CLAUDE*`
    variable of the calling shell goes (a run from inside another Claude Code session would
    otherwise be nested), the credential variables go the way the supervisor drops them,
    and exactly the configured credential comes back."""
    env = {
        k: v
        for k, v in os.environ.items()
        if not (
            k.startswith("CLAUDE") and k not in ("CLAUDE_CODE_OAUTH_TOKEN", "CLAUDE_CONFIG_DIR")
        )
    }
    if cfg.service:
        for var in AUTH_VARS:
            env.pop(var, None)
        env.update(cfg.auth_env)
    env["HOME"] = str(cfg.home)
    env["DISABLE_AUTOUPDATER"] = "1"
    return env


# --------------------------------------------------------------------------------------------------
# The fake daemon: the socket `siltad` would offer, enough of protocol v4 for one session.
# It answers `hello` with `welcome`, records every line the plugin sends, delivers the
# events the checker queues, and answers every command with a successful result.
# --------------------------------------------------------------------------------------------------


class FakeDaemon:
    def __init__(self, path: Path, session: str, trace: Trace):
        self.path = path
        self.session = session
        self.trace = trace
        if path.exists():
            path.unlink()
        self.server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.server.bind(str(path))
        self.server.listen(4)
        self.conn: Optional[socket.socket] = None
        self.writer = None
        self.lock = threading.Lock()
        self.connected = threading.Event()
        self.closed = threading.Event()
        self.thread = threading.Thread(target=self._serve, name="fake-daemon", daemon=True)
        self.thread.start()

    def _serve(self) -> None:
        while True:
            try:
                conn, _ = self.server.accept()
            except OSError:
                return
            self.trace.add({"type": "_daemon", "event": "connected"})
            with self.lock:
                self.conn = conn
                self.writer = conn.makefile("w", encoding="utf-8")
            self.closed.clear()
            reader = conn.makefile("r", encoding="utf-8")
            for raw in reader:
                try:
                    line = json.loads(raw)
                except json.JSONDecodeError:
                    self.trace.add({"type": "_daemon", "event": "garbage", "text": raw[:500]})
                    continue
                self.trace.add({"type": "_daemon", "event": "line", "line": line})
                if "hello" in line:
                    self.send(
                        {
                            "welcome": {
                                "protocol": DAEMON_PROTOCOL,
                                "session": self.session,
                                "user_id": "@silta:contract.check",
                                "people": [{"name": "Alice", "role": "owner"}],
                                "inbox_max_age_days": 30,
                            }
                        }
                    )
                    self.connected.set()
                elif "cmd" in line:
                    # Every command succeeds: the model's reply gets an event id back.
                    self.send(
                        {
                            "result": {
                                "id": line["cmd"]["id"],
                                "ok": True,
                                "event_id": f"$reply-{line['cmd']['id']}",
                            }
                        }
                    )
            self.trace.add({"type": "_daemon", "event": "disconnected"})
            with self.lock:
                self.conn = None
                self.writer = None
            self.closed.set()

    def send(self, obj: dict) -> None:
        with self.lock:
            if self.writer is None:
                self.trace.add({"type": "_daemon", "event": "unsent", "line": obj})
                return
            self.trace.add({"type": "_daemon", "event": "sent", "line": obj})
            self.writer.write(json.dumps(obj, ensure_ascii=False) + "\n")
            self.writer.flush()

    def event(self, event_id: str, text: str, **extra: Any) -> None:
        """A message from Alice in her DM room, as the daemon would deliver it; `extra`
        sets the optional fields (`kind`, `in_reply_to`, `thread`, `reacts_to`,
        `attachments`)."""
        event = {
            "kind": "message",
            "person": "Alice",
            "role": "owner",
            "sender": "@alice:contract.check",
            "room_id": ROOM,
            "room": "dm",
            "event_id": event_id,
            "ts": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
            "text": text,
            "transcribed": False,
            "attachments": [],
        }
        event.update(extra)
        self.send({"event": event})

    def file(self, transfer: str, name: str, mime: str, data: bytes) -> dict:
        """An attachment ahead of the event that names it (protocol.rs `FileHeader`, one
        `chunk`, `file_end`); returns the event's attachment entry."""
        header = {"transfer": transfer, "name": name, "mime": mime, "size": len(data)}
        self.send({"file": header})
        self.send({"chunk": {"transfer": transfer, "data": base64.b64encode(data).decode()}})
        self.send({"file_end": {"transfer": transfer}})
        return header

    def close(self) -> None:
        try:
            self.server.close()
        except OSError:
            pass
        with self.lock:
            if self.conn:
                try:
                    self.conn.close()
                except OSError:
                    pass
        if self.path.exists():
            self.path.unlink()


# --------------------------------------------------------------------------------------------------
# One run of Claude Code, started the way the supervisor starts it.
# --------------------------------------------------------------------------------------------------


class ClaudeRun:
    def __init__(
        self,
        cfg: Config,
        trace: Trace,
        name: str,
        *,
        model: str,
        session_id: Optional[str],
        resume: Optional[str] = None,
        window: Optional[int] = None,
        env: Optional[dict] = None,
        drop: Optional[list[str]] = None,
        extra_args: Optional[list[str]] = None,
        fallback: Optional[str] = None,
    ):
        self.cfg = cfg
        self.trace = trace
        self.name = name
        self.workspace = cfg.state / "workspace"
        self.workspace.mkdir(parents=True, exist_ok=True)
        (self.workspace / "inbox").mkdir(exist_ok=True)
        self.ready_file = cfg.state / "channel-ready"
        self.socket = cfg.state / "siltad.sock"
        prompt = cfg.state / "system-prompt.md"
        prompt.write_text(SYSTEM_PROMPT + "\n", encoding="utf-8")
        # The supervisor's command line (lib.rs `run_once`): the prompt-less print mode,
        # stream-json both ways, `--verbose` (mandatory with stream-json output),
        # `--replay-user-messages` (without it a turn's prompt is not written back and a
        # channel delivery would be invisible), permissions on auto with no prompts, the
        # persona appended to the system prompt, the model knobs, either a fresh id with a
        # name or a resume, and the channel last because `--channels` is variadic.
        args = [
            str(cfg.claude),
            "-p",
            "--input-format",
            "stream-json",
            "--output-format",
            "stream-json",
            "--verbose",
            "--replay-user-messages",
            "--permission-mode",
            "auto",
            "--permission-prompts",
            "none",
            "--append-system-prompt-file",
            str(prompt),
            "--model",
            model,
            "--effort",
            cfg.effort,
        ]
        fallback = fallback if fallback is not None else cfg.fallback_model
        if fallback:
            args += ["--fallback-model", fallback]
        if resume:
            args += ["--resume", resume]
        else:
            args += ["--session-id", session_id, "--name", "silta-contract-check"]
        args += extra_args or []
        # The operator's own (--claude-arg), for a look inside Claude Code such as its
        # debug log; `--channels` stays last.
        args += [a.replace("{logs}", str(cfg.logs)).replace("{run}", name) for a in cfg.claude_args]
        args += ["--channels", CHANNEL]
        self.args = args
        # The environment the supervisor gives Claude Code and, through it, the plugin
        # (lib.rs `run_once`): the state directory as HOME, the plugin's binary for the
        # marketplace's `${SILTA_CLAUDE_BIN}`, the daemon's socket, the inbox, the ready
        # file the plugin waits for, the window, and the knobs Claude Code itself reads.
        run_env = base_env(cfg)
        run_env.update(
            {
                "SILTA_SESSION": "contract-check",
                "SILTA_CLAUDE_BIN": str(cfg.plugin_bin),
                "SILTA_SOCKET": str(self.socket),
                "SILTA_INBOX": str(self.workspace / "inbox"),
                "SILTA_READY_FILE": str(self.ready_file),
                "CLAUDE_CODE_AUTO_COMPACT_WINDOW": str(window or cfg.window),
                # The hook writes the marker under STATE_DIRECTORY, or HOME without it.
                "STATE_DIRECTORY": str(cfg.state),
                "SILTA_ROTATE": "1",
            }
        )
        run_env.update(cfg.passthrough)
        for var in drop or []:
            run_env.pop(var, None)
        run_env.update(env or {})
        self.env = run_env
        if self.ready_file.exists():
            self.ready_file.unlink()
        self.marker = cfg.state / "rotate-requested"
        if self.marker.exists():
            self.marker.unlink()
        # The plugin's MCP log files of this run: those that are not there yet.
        self.mcp_logs = (
            cfg.home
            / ".cache/claude-cli-nodejs"
            / session_slug(self.workspace)
            / f"mcp-logs-plugin-{PLUGIN_NAME}-{SERVER_NAME}"
        )
        self.mcp_logs_before = (
            {f.name for f in self.mcp_logs.iterdir()} if self.mcp_logs.is_dir() else set()
        )
        self.trace.add(
            {
                "type": "_start",
                "run": name,
                "args": args[1:],
                "env": {
                    k: v
                    for k, v in run_env.items()
                    if k.startswith(
                        (
                            "SILTA",
                            "CLAUDE_CODE_AUTO",
                            "CLAUDE_CODE_DIS",
                            "CLAUDE_CODE_SUB",
                            "CLAUDE_CODE_MAX",
                            "STATE",
                        )
                    )
                },
            }
        )
        self.process = subprocess.Popen(
            args,
            cwd=str(self.workspace),
            env=run_env,
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
        )
        self.started = time.monotonic()
        self.stdout_thread = threading.Thread(
            target=self._pump, args=(self.process.stdout, False), daemon=True
        )
        self.stderr_thread = threading.Thread(
            target=self._pump, args=(self.process.stderr, True), daemon=True
        )
        self.stdout_thread.start()
        self.stderr_thread.start()

    def _pump(self, stream, is_err: bool) -> None:
        for raw in stream:
            text = raw.decode("utf-8", "replace").rstrip("\r\n")
            if is_err:
                self.trace.add({"type": "_stderr", "text": text})
                continue
            try:
                line = json.loads(text)
                if not isinstance(line, dict) or "type" not in line:
                    raise ValueError
            except (json.JSONDecodeError, ValueError):
                self.trace.add({"type": "_stdout", "text": text})
                continue
            self.trace.add(line)

    def write(self, obj: dict) -> None:
        self.trace.add(
            {
                "type": "_stdin",
                "line": (
                    obj
                    if len(json.dumps(obj)) < 2000
                    else {"...": f"{len(json.dumps(obj))} bytes", "type": obj.get("type")}
                ),
            }
        )
        try:
            self.process.stdin.write((json.dumps(obj, ensure_ascii=False) + "\n").encode("utf-8"))
            self.process.stdin.flush()
        except (BrokenPipeError, OSError) as e:
            self.trace.add({"type": "_stdin_error", "text": str(e)})

    def send_user(self, text: str) -> None:
        """A host line, as the supervisor writes it (lib.rs `Run::send`)."""
        self.write({"type": "user", "message": {"role": "user", "content": text}})

    def control(self, request_id: str, request: dict) -> None:
        """A control request, as the supervisor writes it (lib.rs `Run::control`)."""
        self.write({"type": "control_request", "request_id": request_id, "request": request})

    def touch_ready(self) -> None:
        """What the supervisor does at the first answer of a model: the plugin may connect.
        Traced before the file appears, so that the plugin's connection can never be
        traced ahead of it."""
        self.trace.add({"type": "_ready"})
        self.ready_file.write_text("contract-check\n", encoding="utf-8")

    def handler_registrations(self) -> int:
        """How many times this run's MCP log says Claude Code attached the channel handler
        (HANDLER_LINE)."""
        if not self.mcp_logs.is_dir():
            return 0
        count = 0
        for f in self.mcp_logs.iterdir():
            if f.name in self.mcp_logs_before or not f.is_file():
                continue
            for line in f.read_text(encoding="utf-8", errors="replace").splitlines():
                try:
                    entry = json.loads(line)
                except json.JSONDecodeError:
                    continue
                text = str(entry.get("debug") or "") if isinstance(entry, dict) else ""
                count += all(word in text for word in HANDLER_LINE)
        return count

    def wait_handler(self, timeout: float) -> bool:
        """Whether the channel handler is attached, looking again every 0.1 s for up to
        `timeout` seconds: the line is written at a turn's start but may reach the file
        a moment later."""
        deadline = time.monotonic() + timeout
        while self.handler_registrations() == 0:
            if time.monotonic() >= deadline:
                return False
            time.sleep(0.1)
        return True

    def wait_delivery(self, start: int, event_id: str) -> Optional[dict]:
        """The `user` line that delivered the event, from index `start` on, waiting up to
        DELIVERY_WAIT."""
        return self.trace.wait(
            lambda line: line.get("type") == "user"
            and any(t.get("event_id") == event_id for t in channel_tags(line)),
            DELIVERY_WAIT,
            start,
        )

    def wait_tool_use(self, start: int, names: tuple[str, ...]) -> Optional[dict]:
        """The main line's first call of one of the named tools from index `start` on."""
        return self.trace.wait(
            lambda line: line.get("type") == "assistant"
            and is_main(line)
            and any(use.get("name") in names for use in tool_uses(line)),
            self.cfg.turn_timeout,
            start,
        )

    def wait_result(self, start: int, timeout: Optional[float] = None) -> Optional[dict]:
        return self.trace.wait(
            lambda line: line.get("type") == "result", timeout or self.cfg.turn_timeout, start
        )

    def close_stdin(self) -> None:
        """The graceful stop: EOF on stdin ends a -p session (lib.rs `begin_stop`)."""
        self.trace.add({"type": "_stdin_eof"})
        try:
            self.process.stdin.close()
        except OSError:
            pass

    def wait_exit(self, timeout: float) -> Optional[int]:
        try:
            code = self.process.wait(timeout=timeout)
        except subprocess.TimeoutExpired:
            self.trace.add(
                {
                    "type": "_exit",
                    "code": None,
                    "seconds": round(time.monotonic() - self.started, 1),
                    "killed": True,
                }
            )
            self.process.kill()
            self.process.wait()
            self.stdout_thread.join(5)
            self.stderr_thread.join(5)
            return None
        self.stdout_thread.join(5)
        self.stderr_thread.join(5)
        self.trace.add(
            {"type": "_exit", "code": code, "seconds": round(time.monotonic() - self.started, 1)}
        )
        return code

    def kill(self) -> None:
        if self.process.poll() is None:
            self.process.kill()
            self.process.wait()


def record_file(trace: Trace, name: str, path: Path, **extra: Any) -> None:
    entry: dict[str, Any] = {
        "type": "_file",
        "name": name,
        "path": str(path),
        "exists": path.exists(),
    }
    if path.is_file():
        try:
            entry["mtime"] = path.stat().st_mtime
            entry["content"] = path.read_text(encoding="utf-8")[:4000]
        except OSError as e:
            entry["error"] = str(e)
    entry.update(extra)
    trace.add(entry)


# --------------------------------------------------------------------------------------------------
# Preconditions, without a model call.
# --------------------------------------------------------------------------------------------------


def check_static(report: Report, cfg: Config) -> Optional[str]:
    """The preconditions, without a model call: the two binaries, the marketplace, the
    hook script and the managed settings. Returns the Claude Code version, if one was
    found."""
    version = check_claude_version(report, cfg)
    plugin_version = check_plugin_binary(report, cfg)
    check_marketplace(report, cfg, plugin_version)
    check_hook_script(report, cfg)
    check_filler_text(report, cfg)
    check_managed_settings(report, cfg)
    return version


def check_claude_version(report: Report, cfg: Config) -> Optional[str]:
    """`claude --version` prints a version; the supervisor reads the same from the `init`
    line and holds it against TESTED_VERSIONS (contract.rs)."""
    try:
        out = subprocess.run(
            [str(cfg.claude), "--version"],
            env=base_env(cfg),
            capture_output=True,
            text=True,
            timeout=60,
        )
    except (OSError, subprocess.TimeoutExpired) as e:
        report.fail("claude --version", f"{cfg.claude}: {e}")
        return None
    m = re.search(r"(\d+\.\d+\.\d+)", out.stdout)
    version = m.group(1) if m else None
    report.check(
        "claude --version",
        version is not None,
        f"{cfg.claude} printed {out.stdout.strip()!r}",
        f"{cfg.claude} is Claude Code {version}",
    )
    if version:
        if version in TESTED_VERSIONS:
            report.info("tested versions", f"{version} is in TESTED_VERSIONS {TESTED_VERSIONS}")
        else:
            report.info(
                "tested versions",
                f"{version} is not in TESTED_VERSIONS {TESTED_VERSIONS}; a pass below is what"
                " adding it takes",
            )
    return version


def check_plugin_binary(report: Report, cfg: Config) -> Optional[str]:
    """`silta-claude --version` works and exits 0: the binary the marketplace's .mcp.json
    starts through `${SILTA_CLAUDE_BIN:-silta-claude}`. Returns its version."""
    try:
        out = subprocess.run(
            [str(cfg.plugin_bin), "--version"], capture_output=True, text=True, timeout=30
        )
    except (OSError, subprocess.TimeoutExpired) as e:
        report.fail("silta-claude --version", f"{cfg.plugin_bin}: {e}")
        return None
    m = re.search(r"silta-claude (\d+\.\d+\.\d+)", out.stdout)
    plugin_version = m.group(1) if m and out.returncode == 0 else None
    report.check(
        "silta-claude --version",
        plugin_version is not None,
        f"{cfg.plugin_bin}: exit {out.returncode}, stdout {out.stdout.strip()!r}, stderr"
        f" {shorten(out.stderr)!r}",
        f"{cfg.plugin_bin} is silta-claude {plugin_version}",
    )
    return plugin_version


def check_marketplace(report: Report, cfg: Config, plugin_version: Optional[str]) -> None:
    """The marketplace as the package ships it (assistant/marketplace): the manifest
    offering the plugin, the plugin's manifest with the binary's version, and its .mcp.json
    whose command is the binary through `${SILTA_CLAUDE_BIN:-silta-claude}`. `claude plugin
    marketplace add` and `plugin install` read these (silta-session-add)."""
    manifest = cfg.marketplace / ".claude-plugin/marketplace.json"
    plugin_json = cfg.marketplace / PLUGIN_NAME / ".claude-plugin/plugin.json"
    mcp_json = cfg.marketplace / PLUGIN_NAME / ".mcp.json"
    if not report.check(
        "marketplace files",
        all(p.is_file() for p in (manifest, plugin_json, mcp_json)),
        f"missing under {cfg.marketplace}:"
        f" {[str(p) for p in (manifest, plugin_json, mcp_json) if not p.is_file()]}",
        str(cfg.marketplace),
    ):
        return
    try:
        market = json.loads(manifest.read_text(encoding="utf-8"))
        plugin = json.loads(plugin_json.read_text(encoding="utf-8"))
        mcp = json.loads(mcp_json.read_text(encoding="utf-8"))
    except (json.JSONDecodeError, OSError) as e:
        report.fail("marketplace files", f"cannot read: {e}")
        return
    names = [p.get("name") for p in market.get("plugins", [])]
    report.check(
        "marketplace manifest",
        market.get("name") == MARKETPLACE_NAME and PLUGIN_NAME in names,
        f"name {market.get('name')!r}, plugins {names}",
        f"{MARKETPLACE_NAME} offers {PLUGIN_NAME}",
    )
    command = mcp.get("mcpServers", {}).get(SERVER_NAME, {}).get("command")
    report.check(
        ".mcp.json",
        command is not None and "SILTA_CLAUDE_BIN" in command,
        f"server {SERVER_NAME!r} command is {command!r}",
        f"server {SERVER_NAME} runs {command}",
    )
    if plugin_version:
        report.check(
            "plugin.json version",
            plugin.get("version") == plugin_version,
            f"plugin.json says {plugin.get('version')}, the binary {plugin_version}",
            f"{plugin_version}, as the binary",
        )


def check_hook_script(report: Report, cfg: Config) -> None:
    """The PreCompact hook (deploy/silta-precompact-block) is next to this script and
    executable: the managed settings name it, and the hook run passes it through
    `--settings` where they do not."""
    report.check(
        "hook script",
        cfg.hook.is_file() and os.access(cfg.hook, os.X_OK),
        f"{cfg.hook} is not an executable file",
        str(cfg.hook),
    )


def check_filler_text(report: Report, cfg: Config) -> None:
    """The book the hook run fills the context with is shipped next to this script or under
    /usr/share/silta (FILLER_FILE); without it the hook run has nothing to send."""
    words = len(cfg.filler.read_text(encoding="utf-8").split()) if cfg.filler.is_file() else 0
    report.check(
        "filler text",
        words > 40_000,
        f"{cfg.filler} is missing or too short ({words} words); the hook run needs a text of"
        " some 60 000 words",
        f"{cfg.filler}, {words} words",
    )


def check_managed_settings(report: Report, cfg: Config) -> None:
    """/etc/claude-code/managed-settings.json (assistant/managed-settings.json): mandatory
    on the VM, where the package installs it with every key in MANAGED_KEYS; on a
    developer's machine its absence is what most often breaks the channel, since an
    organisation account receives no channel messages without `channelsEnabled`."""
    if not cfg.managed_settings.is_file():
        if cfg.service:
            report.fail(
                "managed settings", f"{cfg.managed_settings} is missing; the package installs it"
            )
        else:
            report.warn(
                "managed settings",
                f"no {cfg.managed_settings}: an organisation account then receives no channel"
                " messages, and the channel checks below will fail; the hook run passes the hook"
                " through --settings",
            )
        return
    try:
        managed = json.loads(cfg.managed_settings.read_text(encoding="utf-8"))
    except (json.JSONDecodeError, OSError) as e:
        report.fail("managed settings", f"{cfg.managed_settings}: {e}")
        return
    missing = [k for k in MANAGED_KEYS if k not in managed]
    if cfg.service:
        report.check(
            "managed settings keys",
            not missing,
            f"{cfg.managed_settings} lacks {missing}",
            f"all {len(MANAGED_KEYS)} of MANAGED_KEYS",
        )
    elif missing:
        report.info(
            "managed settings keys",
            f"{cfg.managed_settings} lacks {missing} (the package installs them all; fine"
            " on a developer's machine)",
        )
    report.info(
        "managed settings effects",
        f"seen in the runs: {', '.join(sorted(MANAGED_KEYS_SEEN))}; present only, a rename in"
        " Claude Code would go unnoticed: "
        + ", ".join(k for k in MANAGED_KEYS if k not in MANAGED_KEYS_SEEN),
    )
    report.check(
        "channelsEnabled",
        managed.get("channelsEnabled") is True,
        f"{cfg.managed_settings}: channelsEnabled is {managed.get('channelsEnabled')!r}:"
        f" {MANAGED_KEYS['channelsEnabled']}",
        "true",
    )
    allowed = managed.get("allowedChannelPlugins") or []
    listed = any(
        p.get("marketplace") == MARKETPLACE_NAME and p.get("plugin") == PLUGIN_NAME
        for p in allowed
        if isinstance(p, dict)
    )
    report.check("allowedChannelPlugins", listed, f"{PLUGIN_ID} is not in {allowed}", PLUGIN_ID)
    matchers, commands = precompact_hook(managed)
    runnable = any(c and Path(c).is_file() for c in commands)
    if cfg.service:
        report.check(
            "managed PreCompact hook",
            "auto" in matchers and runnable,
            f"matchers {matchers}, commands {commands}",
            f"matcher auto runs {commands}",
        )
    elif "auto" in matchers and not runnable:
        report.warn(
            "managed PreCompact hook",
            f"the managed hook runs {commands}, which do not exist here: the hook run is skipped",
        )
    if cfg.service:
        servers = managed.get("allowedMcpServers") or []
        allowed_bins = [s.get("serverCommand") for s in servers if isinstance(s, dict)]
        report.check(
            "allowedMcpServers",
            any(str(cfg.plugin_bin) in (cmd or []) for cmd in allowed_bins),
            f"{cfg.plugin_bin} is not among {allowed_bins}",
            str(cfg.plugin_bin),
        )
    report.info(
        "managed hook",
        (
            f"PreCompact matchers {matchers}: the hook run relies on the managed hook"
            if "auto" in matchers
            else (
                "no managed PreCompact hook: the hook run passes the script's own through"
                " --settings"
            )
        ),
    )


def read_managed(cfg: Config) -> Optional[dict]:
    """The managed settings, None when there are none or they cannot be read (which
    check_managed_settings reports)."""
    try:
        managed = json.loads(cfg.managed_settings.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return None
    return managed if isinstance(managed, dict) else None


def precompact_hook(managed: dict) -> tuple[list, list]:
    """The matchers and the commands of the managed PreCompact hooks."""
    hooks = (managed.get("hooks") or {}).get("PreCompact") or []
    matchers = [entry.get("matcher") for entry in hooks if isinstance(entry, dict)]
    commands = [
        h.get("command")
        for entry in hooks
        if isinstance(entry, dict)
        for h in entry.get("hooks", [])
        if isinstance(h, dict)
    ]
    return matchers, commands


def hook_plan(cfg: Config) -> tuple[bool, Optional[str]]:
    """How the hook run gets its hook: from the managed settings (true), or through
    `--settings` (false); with the reason the run is skipped when neither works. A managed
    hook whose command is missing here would never write the marker, and with
    `allowManagedHooksOnly` Claude Code ignores the `--settings` one."""
    managed = read_managed(cfg) or {}
    matchers, commands = precompact_hook(managed)
    if "auto" in matchers:
        if any(c and Path(c).is_file() for c in commands):
            return True, None
        return True, f"the managed PreCompact hook runs {commands}, which do not exist here"
    if managed.get("allowManagedHooksOnly") is True:
        return False, (
            f"{cfg.managed_settings} has no PreCompact hook and allowManagedHooksOnly, so the"
            " script's own hook would be ignored"
        )
    return False, None


# --------------------------------------------------------------------------------------------------
# The plugin's installation, the way `silta-session-add` does it for a mind.
# --------------------------------------------------------------------------------------------------


class PluginInstall:
    def __init__(self, cfg: Config, report: Report):
        self.cfg = cfg
        self.report = report
        self.env = base_env(cfg)
        self.workspace = cfg.state / "workspace"
        self.workspace.mkdir(parents=True, exist_ok=True)
        self.added_marketplace = False
        self.installed = False

    def _claude(self, *args: str, cwd: Optional[Path] = None) -> subprocess.CompletedProcess:
        return subprocess.run(
            [str(self.cfg.claude), *args],
            env=self.env,
            cwd=str(cwd or self.workspace),
            capture_output=True,
            text=True,
            timeout=300,
        )

    def known_marketplace_path(self) -> Optional[str]:
        path = self.cfg.home / ".claude/plugins/known_marketplaces.json"
        if not path.is_file():
            return None
        try:
            known = json.loads(path.read_text(encoding="utf-8"))
        except (json.JSONDecodeError, OSError):
            return None
        entry = known.get(MARKETPLACE_NAME)
        if not isinstance(entry, dict):
            return None
        return entry.get("source", {}).get("path") or entry.get("installLocation")

    def install(self) -> bool:
        """`claude plugin marketplace add <dir>` once, then `plugin install <plugin>@<marketplace>
        --scope project` in the workspace: project scope, because a user-scope install would
        start the plugin in every session of this user."""
        known = self.known_marketplace_path()
        if known and Path(known).resolve() != self.cfg.marketplace.resolve():
            self.report.fail(
                "marketplace add",
                f"{MARKETPLACE_NAME} is already registered for {known}; remove it or pass"
                f" --marketplace {known}",
            )
            return False
        if known:
            self.report.info(
                "marketplace add",
                f"{MARKETPLACE_NAME} was registered already for {known}; left as is",
            )
        else:
            out = self._claude("plugin", "marketplace", "add", str(self.cfg.marketplace))
            if not self.report.check(
                "marketplace add",
                out.returncode == 0,
                f"exit {out.returncode}: {shorten(out.stderr or out.stdout, 400)}",
                f"{MARKETPLACE_NAME} from {self.cfg.marketplace}",
            ):
                return False
            self.added_marketplace = True
        self._claude("plugin", "uninstall", PLUGIN_ID, "--scope", "project")
        out = self._claude("plugin", "install", PLUGIN_ID, "--scope", "project")
        if not self.report.check(
            "plugin install",
            out.returncode == 0,
            f"exit {out.returncode}: {shorten(out.stderr or out.stdout, 400)}",
            f"{PLUGIN_ID} at project scope in {self.workspace}",
        ):
            return False
        self.installed = True
        settings = self.workspace / ".claude/settings.json"
        enabled = {}
        try:
            enabled = json.loads(settings.read_text(encoding="utf-8")).get("enabledPlugins", {})
        except (OSError, json.JSONDecodeError):
            pass
        self.report.check(
            "plugin enabled",
            enabled.get(PLUGIN_ID) is True,
            f"{settings} does not enable {PLUGIN_ID}: {enabled}",
            f"{settings} enables {PLUGIN_ID}",
        )
        return True

    def cleanup(self) -> None:
        """A developer's machine is left as it was found; the service's state directory
        keeps its install (the next run reinstalls anyway, as `silta-session-add` does)."""
        if self.cfg.service:
            return
        if self.installed:
            self._claude("plugin", "uninstall", PLUGIN_ID, "--scope", "project")
        if self.added_marketplace:
            self._claude("plugin", "marketplace", "remove", MARKETPLACE_NAME)
            cache = self.cfg.home / ".claude/plugins/cache" / MARKETPLACE_NAME
            if cache.is_dir():
                shutil.rmtree(cache, ignore_errors=True)


def cleanup_traces(cfg: Config, session_ids: list[str]) -> None:
    """Claude Code kept the runs' transcripts and the memory they wrote under
    <HOME>/.claude/projects/<workspace slug>/ and the plugin's logs under
    <HOME>/.cache/claude-cli-nodejs/<workspace slug>/; both go, the run's own traces keep
    what the checks read. Nothing of the check lingers in a developer's own state, and the
    service's next run starts without the memory of this one."""
    projects = cfg.home / ".claude/projects"
    slug_dirs = set()
    if projects.is_dir():
        for d in projects.iterdir():
            if any((d / f"{sid}.jsonl").is_file() for sid in session_ids):
                slug_dirs.add(d.name)
                shutil.rmtree(d, ignore_errors=True)
    cache = cfg.home / ".cache/claude-cli-nodejs"
    if cache.is_dir():
        for d in cache.iterdir():
            if d.name in slug_dirs:
                shutil.rmtree(d, ignore_errors=True)


def clear_workspace_state(cfg: Config) -> None:
    """The service's workspace is the same at every run: whatever an earlier run left under
    its slug (a run cut short never reached cleanup_traces), memory above all, goes before
    the first turn, so that it cannot steer this run's model."""
    slug = session_slug(cfg.state / "workspace")
    for d in (cfg.home / ".claude/projects" / slug, cfg.home / ".cache/claude-cli-nodejs" / slug):
        if d.is_dir():
            shutil.rmtree(d, ignore_errors=True)


def record_mcp_logs(trace: Trace, home: Path, transcript: Optional[Path]) -> None:
    """Where Claude Code keeps the plugin's stderr: `<HOME>/.cache/claude-cli-nodejs/<slug>/
    mcp-logs-plugin-<plugin>-<server>/`, one file per start (the plugin README; the
    supervisor prunes the directory, state.rs `prune_cache`)."""
    if transcript is None:
        return
    directory = (
        home
        / ".cache/claude-cli-nodejs"
        / transcript.parent.name
        / f"mcp-logs-plugin-{PLUGIN_NAME}-{SERVER_NAME}"
    )
    entry: dict[str, Any] = {
        "type": "_file",
        "name": "mcp-logs",
        "path": str(directory),
        "exists": directory.is_dir(),
    }
    if directory.is_dir():
        files = sorted(f for f in directory.iterdir() if f.is_file())
        entry["files"] = [f.name for f in files]
        entry["content"] = "".join(f.read_text(encoding="utf-8", errors="replace") for f in files)[
            :20000
        ]
    trace.add(entry)


def find_transcript(home: Path, session_id: str) -> Optional[Path]:
    """Where the supervisor looks for a session's transcript (state.rs `Paths::transcript`):
    `<HOME>/.claude/projects/<any project>/<id>.jsonl`."""
    projects = home / ".claude/projects"
    if not projects.is_dir():
        return None
    for d in projects.iterdir():
        p = d / f"{session_id}.jsonl"
        if p.is_file():
            return p
    return None


# --------------------------------------------------------------------------------------------------
# The main run: a fresh session with the channel, driven the way the supervisor drives it.
# --------------------------------------------------------------------------------------------------


def drive_main(cfg: Config, trace: Trace, session_id: str) -> dict:
    """Runs the session and returns what the assertions need to know."""
    meta: dict[str, Any] = {
        "run": "main",
        "session_id": session_id,
        "window": cfg.window,
        "model": cfg.model,
        "intro": INTRO,
        "fallback": cfg.fallback_model,
        "home": str(cfg.home),
        "inbox": str(cfg.state / "workspace" / "inbox"),
        "subagent_model": cfg.passthrough.get("CLAUDE_CODE_SUBAGENT_MODEL"),
    }
    trace.add({"type": "_meta", **meta})
    daemon = FakeDaemon(cfg.state / "siltad.sock", "contract-check", trace)
    run = ClaudeRun(cfg, trace, "main", model=cfg.model, session_id=session_id)
    try:
        # The window check before any turn (lib.rs `run_once`): the host line waits for it.
        run.control(WINDOW_REQUEST, {"subtype": "get_context_usage", "detail": "summary"})
        answer = trace.wait(
            lambda line: line.get("type") == "control_response"
            and line.get("response", {}).get("request_id") == WINDOW_REQUEST,
            60,
        )
        if answer is None:
            trace.add(
                {
                    "type": "_note",
                    "text": "no control_response within 60 s; sending the host line anyway",
                }
            )
        run.send_user(INTRO)
        # The first answer of a model opens the channel (lib.rs `open_channel`).
        first = trace.wait(
            lambda line: line.get("type") == "assistant"
            and is_main(line)
            and line.get("message", {}).get("model") != "<synthetic>",
            cfg.turn_timeout,
        )
        if first is not None:
            run.touch_ready()
        if run.wait_result(0) is None:
            trace.add({"type": "_note", "text": "the first turn did not end; stopping"})
            return meta
        drive_handler(run)
        # The plugin connects once the ready file exists and Claude Code has initialised
        # it; then a message from Alice, whose turn should call the reply tool.
        if daemon.connected.wait(30):
            n = len(trace)
            daemon.event("$alice-1", REPLY_OK)
            if run.wait_delivery(n, "$alice-1") is not None:
                trace.wait(
                    lambda line: line.get("type") == "result" and channel_origin(line),
                    cfg.turn_timeout,
                    n,
                )
            trace.wait_quiet(3, 30)
            drive_midturn(run, daemon)
        else:
            trace.add(
                {
                    "type": "_note",
                    "text": (
                        "the plugin did not connect to the daemon within 30 s of the ready file"
                    ),
                }
            )
        # A subagent in the foreground, whose lines must be told from the main line's.
        n = len(trace)
        run.send_user(SUBAGENT)
        run.wait_result(n)
        trace.wait_quiet(3, 30)
        # A background task, for the level signal the rotation waits on.
        n = len(trace)
        run.send_user(BACKGROUND)
        run.wait_result(n)
        trace.wait(
            lambda line: line.get("type") == "system"
            and line.get("subtype") == "background_tasks_changed"
            and not [t for t in line.get("tasks", []) if not t.get("ambient")],
            60,
            n,
        )
        trace.wait_quiet(4, 60)
        # The rotation's handoff (lib.rs `handoff`): the note in the memory directory next
        # to the transcript, which is where the supervisor watches for it.
        transcript = find_transcript(cfg.home, session_id)
        note = transcript.parent / "memory" / "handoff.md" if transcript else None
        n = len(trace)
        since = time.time()
        run.send_user(HANDOFF)
        run.wait_result(n)
        trace.wait_quiet(3, 30)
        if note is not None:
            record_file(trace, "handoff", note, since=since)
        else:
            trace.add({"type": "_file", "name": "handoff", "path": None, "exists": False})
        # The compaction in place (lib.rs `compact`), with short instructions, and a
        # message from Alice while it runs.
        n = len(trace)
        run.send_user(COMPACT)
        trace.wait(
            lambda line: line.get("type") == "system"
            and (line.get("subtype") == "compact_boundary" or line.get("status") == "compacting"),
            cfg.turn_timeout,
            n,
        )
        sent = len(trace)
        if daemon.connected.is_set():
            daemon.event("$alice-4", REPLY_OK)
        trace.wait(
            lambda line: line.get("type") == "system" and line.get("subtype") == "compact_boundary",
            cfg.turn_timeout,
            n,
        )
        trace.wait(lambda line: line.get("type") == "result", cfg.turn_timeout, n)
        if daemon.connected.is_set() and run.wait_delivery(sent, "$alice-4") is not None:
            trace.wait(
                lambda line: line.get("type") == "result" and channel_origin(line),
                cfg.turn_timeout,
                sent,
            )
        trace.wait_quiet(3, 30)
        # The graceful stop in the middle of a turn: the turn ends, then Claude Code.
        n = len(trace)
        run.send_user(STOP)
        run.wait_tool_use(n, ("Bash",))
        run.close_stdin()
        code = run.wait_exit(cfg.stop_grace)
        if code is not None:
            daemon.closed.wait(10)
        transcript = find_transcript(cfg.home, session_id)
        trace.add(
            {
                "type": "_file",
                "name": "transcript",
                "path": str(transcript) if transcript else None,
                "exists": transcript is not None,
            }
        )
        record_mcp_logs(trace, cfg.home, transcript)
        record_file(trace, "marker", run.marker)
        return meta
    finally:
        run.kill()
        daemon.close()
        trace.close()


def drive_handler(run: ClaudeRun) -> None:
    """After the first turn, the channel handler (HANDLER_LINE): attached by then, or at the
    start of one of up to HANDLER_TURNS - 1 turns of NOOP. Each look is recorded, for
    check_channel_handler."""
    trace = run.trace
    turn = 1
    while True:
        registered = run.wait_handler(2)
        trace.add(
            {
                "type": "_handler",
                "after_turn": turn,
                "registered": registered,
                "mcp_logs": str(run.mcp_logs),
            }
        )
        if registered or turn >= HANDLER_TURNS:
            return
        n = len(trace)
        run.send_user(NOOP)
        if run.wait_result(n) is None:
            return
        turn += 1


def drive_midturn(run: ClaudeRun, daemon: FakeDaemon) -> None:
    """Two messages from Alice while a turn runs, as a person writes while the mind works:
    one in a thread, quoting her first message, with a file; then a reaction to the mind's
    first reply."""
    trace = run.trace
    n = len(trace)
    run.send_user(MIDTURN)
    if run.wait_tool_use(n, ("Bash",)) is None:
        trace.add({"type": "_note", "text": "no Bash call in the mid-turn turn"})
    name, mime, data = ATTACHMENT
    attachment = daemon.file("contract-1", name, mime, data)
    daemon.event(
        "$alice-2",
        REPLY_IN_THREAD,
        in_reply_to="$alice-1",
        thread=THREAD,
        attachments=[attachment],
    )
    daemon.event("$alice-3", "👍", kind="reaction", reacts_to="$reply-1")
    delivered = [run.wait_delivery(n, event_id) for event_id in ("$alice-2", "$alice-3")]
    if delivered[0] is not None:
        trace.wait(
            lambda line: line["type"] == "_daemon"
            and (line.get("line", {}).get("cmd", {}).get("reply") or {}).get("thread") == THREAD,
            run.cfg.turn_timeout,
            n,
        )
    trace.wait_quiet(5, run.cfg.turn_timeout)


def check_main(report: Report, trace: Trace, meta: dict) -> Optional[str]:
    """The main run, from the session's start to its stop: one function per contract
    point, in the order the run produced the evidence. Returns the Claude Code version
    seen on the `init` line."""
    lines = stdout_lines(trace)
    init = check_init(report, lines, meta)
    if init is None:
        return None
    check_init_plugin(report, init)
    check_init_memory_paths(report, init, meta)
    check_init_lines(report, lines, init)
    check_window_answer(report, lines, meta)
    check_replayed_host_line(report, lines, meta)
    check_assistant_usage(report, lines)
    check_results(report, lines)
    check_no_fallback(report, lines)
    check_plugin_connection(report, trace)
    check_channel_handler(report, trace)
    check_channel_delivery(report, lines)
    check_midturn_delivery(report, trace, meta)
    check_subagent(report, lines, meta)
    check_background_tasks(report, lines)
    check_handoff(report, trace, lines, meta)
    check_compaction(report, trace)
    check_compaction_delivery(report, trace)
    check_stop(report, trace)
    check_files(report, trace, meta)
    report_stderr(report, "main: ", trace)
    report_line_kinds(report, lines)
    version = init.get("claude_code_version")
    return version if isinstance(version, str) else None


def check_init(report: Report, lines: list[dict], meta: dict) -> Optional[dict]:
    """`system init` opens the session (stream.rs `system_event`, `Event::Init`): it names
    the Claude Code version the supervisor holds against TESTED_VERSIONS, the session id
    the supervisor gave with `--session-id`, and the permission mode. Returns the line."""
    inits = of_type(lines, "system", "init")
    if not report.check(
        "main: system init",
        bool(inits),
        "no system init line; the supervisor never learns the session id or the version",
    ):
        return None
    init = inits[0]
    version = init.get("claude_code_version")
    report.check(
        "main: init claude_code_version",
        isinstance(version, str) and bool(version),
        f"claude_code_version is {version!r}",
        str(version),
    )
    report.check(
        "main: init session_id",
        init.get("session_id") == meta["session_id"],
        f"--session-id {meta['session_id']} came back as {init.get('session_id')!r}",
        "the --session-id given",
    )
    report.check(
        "main: init permissionMode",
        init.get("permissionMode") == "auto",
        f"permissionMode is {init.get('permissionMode')!r}",
        "auto",
    )
    return init


def check_init_plugin(report: Report, init: dict) -> None:
    """The plugin is in the session: `--channels plugin:silta-claude@silta-local` (lib.rs
    `CHANNEL`) started it as an MCP server, its tools are named `mcp__plugin_<plugin>_
    <server>__<tool>` (the reply tool above all, which the persona and the compaction
    prompt rely on), and the init line lists the server as connected and the plugin as
    loaded."""
    tools = init.get("tools") or []
    servers = {
        s.get("name"): s.get("status") for s in init.get("mcp_servers", []) if isinstance(s, dict)
    }
    report.check(
        "main: init reply tool",
        REPLY_TOOL in tools,
        f"{REPLY_TOOL} is not among the session's tools (MCP servers: {servers}); a mind could not"
        " answer",
        f"{REPLY_TOOL} among {len(tools)} tools",
    )
    plugin_tools = sorted(t[len(TOOL_PREFIX) :] for t in tools if t.startswith(TOOL_PREFIX))
    report.info("main: init plugin tools", ", ".join(plugin_tools) or "none")
    server_status = [
        s for name, s in servers.items() if PLUGIN_NAME in str(name) or name == SERVER_NAME
    ]
    report.check(
        "main: init mcp server",
        "connected" in server_status,
        f"the plugin's server is not connected: {servers}",
        f"{servers}",
    )
    plugins = init.get("plugins")
    if isinstance(plugins, list):
        names = [p.get("name") if isinstance(p, dict) else p for p in plugins]
        report.check(
            "main: init plugins",
            any(PLUGIN_NAME in str(n) for n in names),
            f"{PLUGIN_NAME} is not among the plugins: {names}",
            f"{names}",
        )


def check_init_memory_paths(report: Report, init: dict, meta: dict) -> None:
    """The memory directory is `<HOME>/.claude/projects/<slug>/memory`: the rotation looks
    for the handoff note there (state.rs `memory_dirs`, `HANDOFF_NOTE`), and 2.1.283's init
    line names it under `memory_paths`."""
    memory_paths = init.get("memory_paths")
    if memory_paths is None:
        report.info("main: init memory_paths", "absent from the init line")
        return

    def strings(o: Any) -> list[str]:
        if isinstance(o, str):
            return [o]
        if isinstance(o, dict):
            return [x for v in o.values() for x in strings(v)]
        if isinstance(o, list):
            return [x for v in o for x in strings(v)]
        return []

    projects = str(Path(meta.get("home", "")) / ".claude/projects") + "/"
    hits = [
        x
        for x in strings(memory_paths)
        if x.startswith(projects) and x.rstrip("/").endswith("/memory")
    ]
    report.check(
        "main: init memory_paths",
        bool(hits),
        f"memory_paths {shorten(memory_paths, 300)} names no {projects}<slug>/memory: the"
        " handoff note would never be found",
        hits[0] if hits else "",
    )


def check_init_lines(report: Report, lines: list[dict], init: dict) -> None:
    """For the record: the fields of the init line, and how many init lines the run had.
    2.1.283 writes one at the start of every turn, not only at the start of the session;
    the supervisor reads each as `Event::Init` and repeats its version line on purpose."""
    report.info(
        "main: init fields", ", ".join(sorted(k for k in init.keys() if not k.startswith("_")))
    )
    inits = of_type(lines, "system", "init")
    report.info("main: init lines", f"{len(inits)} for {len(of_type(lines, 'result'))} turns")


def check_window_answer(report: Report, lines: list[dict], meta: dict) -> None:
    """The window check (lib.rs `Run::window`, stream.rs `control_response`): a
    `control_request` with `get_context_usage`, written before the first host line, is
    answered by a `control_response` echoing its `request_id`, with `subtype` `success` and
    the window Claude Code measures the context against in `response.maxTokens`. The
    supervisor starts the first turn only when that is at least
    CLAUDE_CODE_AUTO_COMPACT_WINDOW and ends the session with exit 79 otherwise; no answer
    or an error answer ends it with exit 1."""
    answers = [
        line
        for line in of_type(lines, "control_response")
        if line.get("response", {}).get("request_id") == WINDOW_REQUEST
    ]
    if not report.check(
        "main: control_response",
        bool(answers),
        "no control_response to get_context_usage; the supervisor ends every start after 60 s",
    ):
        return
    response = answers[0]["response"]
    max_tokens = (
        response.get("response", {}).get("maxTokens")
        if isinstance(response.get("response"), dict)
        else None
    )
    if not report.check(
        "main: get_context_usage",
        response.get("subtype") == "success" and isinstance(max_tokens, int),
        f"answered {response.get('subtype')!r} without an integer response.maxTokens:"
        f" {shorten(response.get('error') or response)}; every start would end with exit 79",
        f"maxTokens {max_tokens}",
    ):
        return
    report.check(
        "main: window",
        max_tokens >= meta["window"],
        f"maxTokens {max_tokens} is below CLAUDE_CODE_AUTO_COMPACT_WINDOW={meta['window']}:"
        f" this Claude Code does not know {meta['model']}'s window, and every start would"
        " end with exit 79",
        f"{max_tokens} >= {meta['window']}",
    )


def check_replayed_host_line(report: Report, lines: list[dict], meta: dict) -> None:
    """With `--replay-user-messages` every prompt written to stdin comes back as a `user`
    line (stream.rs `Event::User`). The supervisor needs it for channel deliveries, whose
    replayed line carries the channel origin the idle gap is measured from; the host line
    is the cheap way to see that the flag still works."""
    replayed = [line for line in of_type(lines, "user") if content_text(line) == meta["intro"]]
    report.check(
        "main: replayed user line",
        bool(replayed),
        "the host line did not come back as a user line with --replay-user-messages; a channel"
        " delivery would not be seen either",
    )


def check_assistant_usage(report: Report, lines: list[dict]) -> None:
    """Every main-line `assistant` line (`parent_tool_use_id` null) carries
    `message.usage` with `input_tokens`, `cache_read_input_tokens` and
    `cache_creation_input_tokens`: their sum is the context size the threshold rotation
    trips on (stream.rs `context_of`, rotation.rs `Tracker::event`; contract.rs warns when
    it is missing). Lines of a subagent and Claude Code's own `<synthetic>` messages do not
    count."""
    assistants = [
        line
        for line in of_type(lines, "assistant")
        if is_main(line) and line.get("message", {}).get("model") != "<synthetic>"
    ]
    if not report.check(
        "main: assistant lines",
        bool(assistants),
        "no main-line assistant line (type assistant with parent_tool_use_id null)",
    ):
        return
    missing = []
    for line in assistants:
        usage = line.get("message", {}).get("usage")
        keys = ("input_tokens", "cache_read_input_tokens", "cache_creation_input_tokens")
        if not isinstance(usage, dict) or not all(isinstance(usage.get(k), int) for k in keys):
            missing.append(shorten(usage, 100))
    report.check(
        "main: assistant usage",
        not missing,
        f"{len(missing)} of {len(assistants)} main-line assistant lines lack integer usage"
        f" counts: {missing[:2]}; the threshold rotation would be blind",
        f"{len(assistants)} lines, each with the three prompt counts",
    )
    report.info(
        "main: models",
        ", ".join(sorted({str(line.get("message", {}).get("model")) for line in assistants})),
    )


def check_results(report: Report, lines: list[dict]) -> None:
    """A `result` line ends every turn, with a boolean `is_error` (stream.rs
    `Event::Result`): the rotation acts on turn ends, and the handoff turn is retried or
    given up on an error. The first turn, started by the host line, ends without an error
    and without a channel origin."""
    results = of_type(lines, "result")
    if not report.check(
        "main: result lines", bool(results), "no result line; the supervisor never sees a turn end"
    ):
        return
    bad = [line for line in results if not isinstance(line.get("is_error"), bool)]
    report.check(
        "main: result is_error",
        not bad,
        f"{len(bad)} result lines without a boolean is_error",
        f"{len(results)} results",
    )
    first = results[0]
    report.check(
        "main: first result",
        first.get("is_error") is False and not channel_origin(first),
        f"the first turn ended with is_error {first.get('is_error')!r}, origin"
        f" {first.get('origin')!r}: {shorten(first.get('result'))}",
        "no error, no channel origin",
    )


def check_no_fallback(report: Report, lines: list[dict]) -> None:
    """No `system model_fallback` in the main run: the configured model serves this Claude
    Code as it is. A fatal trigger would end a mind's session with exit 79 (lib.rs
    `Run::fallback`)."""
    fallbacks = of_type(lines, "system", "model_fallback")
    report.check(
        "main: no model_fallback",
        not fallbacks,
        f"{[f.get('trigger') for f in fallbacks]}: the configured model cannot serve; the"
        " supervisor would end the session",
        "the configured model served every turn",
    )


def check_plugin_connection(report: Report, trace: Trace) -> None:
    """The plugin's side of the channel, seen by the fake daemon: it connects only after the
    ready file exists (SILTA_READY_FILE, written by the supervisor at the first answer of a
    model, lib.rs `open_channel`; a session whose model cannot serve must not take a
    message), speaks protocol v4 with its session name in `hello` (protocol.rs), sends each
    delivered event's `ack` once it has written the event's notification to Claude Code
    (whether Claude Code took it in is what the checks of the `user` lines below say),
    forwards the model's reply as a `cmd` with the room, the text and `more`, and closes
    its connection when Claude Code exits (main.rs, PDEATHSIG)."""
    daemon_events = [line for line in trace.lines if line["type"] == "_daemon"]
    if not daemon_events:
        report.skip("main: channel", "no daemon events in the trace")
        return
    ready_at = next((i for i, line in enumerate(trace.lines) if line["type"] == "_ready"), None)
    connected_at = next(
        (
            i
            for i, line in enumerate(trace.lines)
            if line["type"] == "_daemon" and line.get("event") == "connected"
        ),
        None,
    )
    report.check(
        "main: plugin connects after the ready file",
        connected_at is not None and ready_at is not None and connected_at > ready_at,
        f"connected at trace index {connected_at}, ready file at {ready_at}: the plugin must"
        " wait for the ready file (SILTA_READY_FILE), else a session whose model cannot serve"
        " takes messages",
        "SILTA_READY_FILE honoured",
    )
    received = [line["line"] for line in daemon_events if line.get("event") == "line"]
    hello = next((line["hello"] for line in received if "hello" in line), None)
    if report.check(
        "main: plugin hello", hello is not None, "the plugin never sent hello to the daemon"
    ):
        report.check(
            "main: plugin protocol",
            hello.get("protocol") == DAEMON_PROTOCOL and hello.get("session") == "contract-check",
            f"hello {hello}",
            f"protocol {DAEMON_PROTOCOL}, session contract-check, client {hello.get('client')}",
        )
    acked = {line["ack"].get("event_id") for line in received if "ack" in line}
    events = [
        line["line"]["event"]["event_id"]
        for line in daemon_events
        if line.get("event") == "sent" and "event" in line.get("line", {})
    ]
    unacked = [e for e in events if e not in acked]
    report.check(
        "main: plugin ack",
        bool(events) and not unacked,
        f"the plugin did not acknowledge {unacked or events} (acks: {sorted(acked)})",
        f"{', '.join(events)} acknowledged once written to Claude Code",
    )
    cmds = [line["cmd"] for line in received if "cmd" in line]
    replies = [c["reply"] for c in cmds if "reply" in c]
    if report.check(
        "main: reply reaches the daemon",
        bool(replies),
        "no reply command reached the daemon (commands:"
        f" {[list(k for k in c if k != 'id') for c in cmds]}); the model's answer never left"
        " the session",
    ):
        r = replies[0]
        # `more` is left out on the wire when false (protocol.rs `Reply`).
        report.check(
            "main: reply fields",
            r.get("room_id") == ROOM
            and isinstance(r.get("text"), str)
            and isinstance(r.get("more", False), bool),
            f"reply {shorten(r)}",
            f"room_id from the tag, text {shorten(r.get('text'), 40)!r}, more"
            f" {r.get('more', False)}",
        )
    disconnected = [line for line in daemon_events if line.get("event") == "disconnected"]
    report.check(
        "main: plugin exits with the session",
        bool(disconnected),
        "the plugin's connection to the daemon stayed open after Claude Code exited",
        "the connection closed",
    )


def check_channel_handler(report: Report, trace: Trace) -> None:
    """Claude Code has the handler of the plugin's channel notifications in place by the end
    of the first turn (HANDLER_LINE in the plugin's MCP log). It attaches it at a turn's
    start once a fetch of its own at startup has finished; when the first turn starts
    earlier, the handler comes only with the next turn, and a notification before then is
    dropped without a trace. The supervisor starts the first turn right after the window
    check and opens the channel at the model's first answer, so a message the daemon hands
    over then is acknowledged by the plugin and lost. Whether the first turn wins that race
    depends on the network, hence a warning; the run itself goes on with turns of NOOP
    until the handler is attached, so that the checks of the deliveries below do not."""
    looks = [line for line in trace.lines if line["type"] == "_handler"]
    if not looks:
        report.skip(
            "main: channel handler",
            "the trace has no look at the handler: the run ended in its first turn, or the trace"
            " predates the look",
        )
        return
    attached = next((look for look in looks if look.get("registered")), None)
    if attached is None:
        report.fail(
            "main: channel handler",
            f"no line with {' and '.join(HANDLER_LINE)} in the plugin's MCP log"
            f" ({looks[-1].get('mcp_logs')}) after {looks[-1].get('after_turn')} turns: Claude"
            " Code did not attach the channel handler, or no longer says so there",
        )
    elif attached is looks[0]:
        report.ok("main: channel handler", "attached by the end of the first turn")
    else:
        report.warn(
            "main: channel handler",
            f"attached only at turn {attached.get('after_turn')}: the first turn started before"
            " Claude Code's startup fetch had finished, so a queued message the daemon hands over"
            " when the plugin connects in a mind's first turn is dropped, and acknowledged",
        )


def check_channel_delivery(report: Report, lines: list[dict]) -> None:
    """Claude Code's side of the channel: the plugin's `notifications/claude/channel` becomes
    a `user` line whose text is a `<channel source="plugin:silta-claude:silta"
    person="Alice" ... room_id event_id ts>` tag (the attributes the plugin's instructions
    to the model quote, mcp.rs `INSTRUCTIONS`) with `origin.kind` `channel`, and the
    `result` of the turn it starts carries the same origin: both are what the supervisor
    takes as a person's presence for the idle gap (stream.rs `person_of`,
    `channel_origin`). In that turn the model answers with the reply tool, whose result is
    not an error."""
    users = of_type(lines, "user")
    _, u, tag = find_delivery(lines, "$alice-1")
    if not u:
        # A channel line without the tag means its text changed, not that it was lost.
        untagged = [line for line in users if channel_origin(line) and not channel_tags(line)]
        report.fail(
            "main: channel user line",
            (
                "a user line has the channel origin but no <channel ... event_id> tag:"
                f" {shorten(content_text(untagged[0]), 200)!r}"
                if untagged
                else "$alice-1, which the plugin handed to Claude Code, never appeared as a user"
                " line: Claude Code dropped the notification (see main: channel handler; the"
                " managed settings? the plugin allowlist?)"
            ),
        )
        return
    report.ok("main: channel user line", "$alice-1 delivered")
    text = (content_text(u) or "").lstrip()
    report.check(
        "main: channel origin",
        channel_origin(u),
        f"the user line has no origin.kind == channel: {shorten(u.get('origin'))}; the"
        " supervisor then relies on the <channel text alone",
        f"origin {u.get('origin')}",
    )
    want = {
        "source": CHANNEL_SOURCE,
        "person": "Alice",
        "role": "owner",
        "room": "dm",
        "room_id": ROOM,
        "event_id": "$alice-1",
    }
    wrong = {k: tag.get(k) for k, v in want.items() if tag.get(k) != v}
    report.check(
        "main: channel tag",
        text.startswith("<channel") and not wrong and bool(tag.get("ts")),
        f"the user text is {shorten(text, 300)!r}; wrong or missing attributes"
        f" {wrong | ({} if tag.get('ts') else {'ts': None})}, expected {want} and ts",
        f'<channel source="{CHANNEL_SOURCE}" person="Alice" role room room_id event_id ts>',
    )
    report.check(
        "main: channel result",
        any(channel_origin(r) for r in of_type(lines, "result")),
        "no result line with origin.kind == channel: the turn a delivery starts is not marked"
        " as a person's",
        "the delivery's turn is marked",
    )
    used = [t.get("name") for line in of_type(lines, "assistant") for t in tool_uses(line)]
    report.check(
        "main: reply tool call",
        REPLY_TOOL in used,
        f"the model called {sorted(set(used))} but not {REPLY_TOOL} (model-dependent; check the"
        " trace)",
        REPLY_TOOL,
    )
    # The plugin's tools must work; the model's other tools may fail on the way to what it
    # was asked (a Bash write the sandbox refuses, a Read of a file not there yet), which
    # the checks of each turn judge by the outcome.
    plugin_calls = {
        use.get("id")
        for line in of_type(lines, "assistant")
        for use in tool_uses(line)
        if str(use.get("name", "")).startswith(TOOL_PREFIX)
    }
    failed = [b for line in users for b in tool_results(line) if b.get("is_error") is True]
    errors = [b for b in failed if b.get("tool_use_id") in plugin_calls]
    report.check(
        "main: plugin tool results",
        bool(plugin_calls) and not errors,
        f"{len(errors)} of the plugin's tool results are errors:"
        f" {[shorten(result_text(b), 150) for b in errors[:2]]}",
        f"{len(plugin_calls)} calls, none failed",
    )
    others = [b for b in failed if b.get("tool_use_id") not in plugin_calls]
    if others:
        report.info(
            "main: other tool errors",
            f"{len(others)}: " + " | ".join(shorten(result_text(b), 120) for b in others[:3]),
        )


def check_midturn_delivery(report: Report, trace: Trace, meta: dict) -> None:
    """Messages that arrive while a turn runs, as a person writes while the mind works:
    Claude Code keeps them and delivers each as a `user` line with the channel origin, in
    that turn or the next (stream.rs `person_of`); the supervisor writes the ready file in
    the middle of the first turn, so this is also what a session's first messages meet.
    Their tags carry the optional attributes the plugin's instructions quote (mcp.rs
    `channel_params`): `thread` and `in_reply_to`, the `attachment_<n>_*` of a file
    already in the inbox, and `kind` with `reacts_to` for a reaction. The model answers
    the one in the thread in the thread (model-dependent)."""
    lines = trace.lines
    host = stdin_at(trace, MIDTURN)
    sent = sent_at(trace, "$alice-2")
    if host is None or sent is None:
        report.skip("main: mid-turn delivery", "the run did not get as far as the mid-turn turn")
        return
    ended = next(
        (i for i in range(host, len(lines)) if lines[i].get("type") == "result"), len(lines)
    )
    if sent > ended:
        report.warn(
            "main: mid-turn delivery",
            "the turn had ended before the messages were sent (did the model run the command"
            " in the foreground?): not judged",
        )
    else:
        at, line, _ = find_delivery(lines, "$alice-2")
        report.check(
            "main: mid-turn delivery",
            at is not None and channel_origin(line),
            (
                "a message that arrived during a turn never appeared as a user line: Claude"
                " Code dropped it, and a person writing to a busy mind is not heard"
                if at is None
                else f"its user line has no channel origin: {shorten(line.get('origin'))}"
            ),
            "delivered with the channel origin"
            + (" within the turn" if at is not None and at < ended else " after the turn"),
        )
    _, _, tag = find_delivery(lines, "$alice-2")
    name, mime, data = ATTACHMENT
    want = {
        "thread": THREAD,
        "in_reply_to": "$alice-1",
        "attachment_1_name": name,
        "attachment_1_mime": mime,
        "attachment_1_size": str(len(data)),
    }
    wrong = {k: tag.get(k) for k, v in want.items() if tag.get(k) != v}
    path = tag.get("attachment_1_path", "")
    if not path.startswith(meta.get("inbox", "") + "/"):
        wrong["attachment_1_path"] = path or None
    report.check(
        "main: channel tag thread and file",
        bool(tag) and not wrong,
        f"$alice-2's tag lacks or changed {wrong} (tag: {tag}): the model would not see the"
        " thread, the quote or the file",
        f"thread, in_reply_to, attachment_1_* with {path}",
    )
    _, _, tag = find_delivery(lines, "$alice-3")
    report.check(
        "main: channel tag reaction",
        tag.get("kind") == "reaction" and tag.get("reacts_to") == "$reply-1",
        f"$alice-3's tag is {tag or 'missing'}; expected kind reaction, reacts_to $reply-1",
        "kind reaction, reacts_to $reply-1",
    )
    replies = [
        line["line"]["cmd"]["reply"]
        for line in lines
        if line["type"] == "_daemon"
        and line.get("event") == "line"
        and "reply" in line.get("line", {}).get("cmd", {})
    ]
    report.check(
        "main: reply in thread",
        any(r.get("thread") == THREAD for r in replies),
        f"no reply with thread {THREAD} (replies: {[shorten(r, 80) for r in replies]};"
        " model-dependent, check the trace)",
        f"thread {THREAD}",
    )


def check_subagent(report: Report, lines: list[dict], meta: dict) -> None:
    """A subagent's lines carry the `parent_tool_use_id` of the call that started it
    (stream.rs `subagent`): the supervisor takes the context size from main-line
    `assistant` lines alone, and a subagent line without the marker would stand for the
    mind's context and trip or hold off the threshold rotation. Seen with a foreground
    agent, during which the main line writes nothing: an unmarked `assistant` line inside
    the call is the subagent's. The subagent runs on CLAUDE_CODE_SUBAGENT_MODEL, the unit's
    knob."""
    uses = main_tool_uses(lines, ("Agent", "Task"))
    if not report.check(
        "main: subagent call",
        bool(uses),
        "the model never called the Agent tool (model-dependent; check the trace)",
        str(uses[0][1].get("name")) if uses else "",
    ):
        return
    at, use = uses[0]
    call = use.get("id")
    done, block = find_tool_result(lines, call or "")
    backgrounded = any(
        line.get("subtype") == "task_started"
        and line.get("tool_use_id") == call
        and line.get("is_backgrounded")
        for line in of_type(lines, "system")
    )
    if done is None or backgrounded:
        report.warn(
            "main: subagent lines marked",
            "the agent ran in the background or never ended: its lines cannot be told apart",
        )
        return
    message_id = lines[at].get("message", {}).get("id")
    unmarked = [
        line
        for line in lines[at + 1 : done]
        if line.get("type") == "assistant"
        and is_main(line)
        and line.get("message", {}).get("id") != message_id
    ]
    marked = [line for line in lines if line.get("parent_tool_use_id") == call]
    report.check(
        "main: subagent lines marked",
        not unmarked,
        f"{len(unmarked)} assistant lines without parent_tool_use_id while the agent ran"
        f" (models {sorted({str(u.get('message', {}).get('model')) for u in unmarked})}): the"
        " supervisor would take a subagent's context for the mind's",
        (
            f"{len(marked)} lines with parent_tool_use_id {call}"
            if marked
            else "Claude Code writes none of the subagent's lines"
        ),
    )
    want = meta.get("subagent_model")
    models = sorted(
        {
            str(line.get("message", {}).get("model"))
            for line in marked
            if line.get("type") == "assistant"
        }
        - {"<synthetic>"}
    )
    if not want:
        report.info("main: subagent model", f"{models}; CLAUDE_CODE_SUBAGENT_MODEL is not set")
    elif not models:
        report.skip("main: subagent model", "no subagent lines to read the model from")
    else:
        report.check(
            "main: subagent model",
            models == [want],
            f"the subagent ran on {models}, not CLAUDE_CODE_SUBAGENT_MODEL={want}",
            want,
        )
    report.info("main: subagent result", shorten(result_text(block), 120))


def check_handoff(report: Report, trace: Trace, lines: list[dict], meta: dict) -> None:
    """The rotation's handoff turn (lib.rs `handoff`): asked for the memory note `handoff`,
    the model writes handoff.md into its memory directory, `<HOME>/.claude/projects/<slug>/
    memory`, next to the transcript, which is where the supervisor watches for the write
    (state.rs `handoff_written`); in auto mode, with no permission prompt. Without it
    every rotation waits out its cap and is given up."""
    note = trace_file(trace, "handoff")
    if note is None:
        report.skip("main: handoff note", "the run did not get as far as the handoff")
        return
    written = note.get("exists") is True and note.get("mtime", 0) >= note.get("since", 0) - 1
    host = stdin_at(trace, HANDOFF)
    paths = [
        str((use.get("input") or {}).get("file_path"))
        for _, use in main_tool_uses(
            [line for line in trace.lines[host or 0 :] if not line["type"].startswith("_")],
            ("Write", "Edit"),
        )
    ]
    report.check(
        "main: handoff note",
        written,
        f"{note.get('path')} was not written by the handoff turn (the model wrote"
        f" {paths or 'nothing'}): the supervisor would never see a handoff",
        str(note.get("path")),
    )


def check_compaction_delivery(report: Report, trace: Trace) -> None:
    """A message that arrives while `/compact` runs is kept and delivered after it, with
    the channel origin, and its turn ends with a `result` of its own: the rotation takes a
    `result` without a boundary for such a turn and goes on waiting for the compaction
    (rotation.rs `Phase::Compacting`)."""
    sent = sent_at(trace, "$alice-4")
    if sent is None:
        report.skip("main: delivery during /compact", "no message was sent during the compaction")
        return
    lines = trace.lines
    boundary = next(
        (
            i
            for i in range(sent, len(lines))
            if lines[i].get("type") == "system" and lines[i].get("subtype") == "compact_boundary"
        ),
        None,
    )
    at, line, _ = find_delivery(lines, "$alice-4")
    result = next(
        (
            i
            for i in range(at or len(lines), len(lines))
            if lines[i].get("type") == "result" and channel_origin(lines[i])
        ),
        None,
    )
    report.check(
        "main: delivery during /compact",
        at is not None and channel_origin(line) and result is not None,
        (
            "the message sent during the compaction never appeared as a user line: Claude Code"
            " dropped it"
            if at is None
            else "its turn did not end with a result carrying the channel origin"
        ),
        "delivered "
        + ("after the boundary" if None not in (at, boundary) and at > boundary else "as it came")
        + ", its turn ended with a channel result"
        + ("" if boundary is not None else " (sent after the compaction had ended)"),
    )


def check_background_tasks(report: Report, lines: list[dict]) -> None:
    """`system background_tasks_changed` is the level signal of background tasks (stream.rs
    `Event::BackgroundTasks`): the full live set after each change, `tasks[].task_id` as
    strings, ambient ones flagged. The rotation waits for its quiet moment until the set is
    empty (rotation.rs `Tracker::quiet`). Model-dependent: the run asks for a Bash command
    in the background."""
    changed = of_type(lines, "system", "background_tasks_changed")

    def live_tasks(line: dict) -> list[dict]:
        return [t for t in line.get("tasks", []) if not t.get("ambient")]

    busy = [line for line in changed if live_tasks(line)]
    if not report.check(
        "main: background_tasks_changed",
        bool(busy),
        "no background_tasks_changed line with a task: the rotation could not wait for agents"
        " (model-dependent: did the Bash tool run in the background?)",
    ):
        return
    live = live_tasks(busy[0])
    ids = [t.get("task_id") for t in live]
    report.check(
        "main: background task ids",
        all(isinstance(i, str) and i for i in ids),
        f"tasks without a string task_id: {live}",
        f"tasks {ids}, types {[t.get('task_type') for t in live]}",
    )
    idle_after = any(not live_tasks(line) for line in changed[changed.index(busy[0]) + 1 :])
    report.check(
        "main: background tasks end",
        idle_after,
        "no later background_tasks_changed with the task gone: the rotation would wait for its"
        " quiet moment until the cap",
        "a later line with no task",
    )


def check_compaction(report: Report, trace: Trace) -> None:
    """The compaction in place (lib.rs `compact`, rotation.rs `Phase::Compacting`): a `user`
    line whose content starts with `/compact ` runs a manual compaction, answered by `system
    status` lines (`compacting`, then `compact_result` `success`), a `system
    compact_boundary` with `compact_metadata.trigger` `manual`, and a `result`. The
    `/compact` line itself is not replayed, so it is found among what was written."""
    compact_at = next(
        (
            i
            for i, line in enumerate(trace.lines)
            if line["type"] == "_stdin"
            and str(line.get("line", {}).get("message", {}).get("content", "")).startswith(
                "/compact"
            )
        ),
        None,
    )
    after = (
        [line for line in trace.lines[compact_at:] if not line["type"].startswith("_")]
        if compact_at is not None
        else []
    )
    statuses = of_type(after, "system", "status")
    boundaries = of_type(after, "system", "compact_boundary")
    if not report.check(
        "main: compact_boundary",
        bool(boundaries),
        "no compact_boundary after /compact: the rotation would take the compaction as failed",
    ):
        return
    b = boundaries[0]
    md = b.get("compact_metadata") or {}
    report.check(
        "main: compact trigger",
        md.get("trigger") == "manual",
        f"compact_metadata.trigger is {md.get('trigger')!r}: an automatic trigger would be read"
        " as Claude Code compacting on its own",
        f"manual, pre_tokens {md.get('pre_tokens')}, post_tokens {md.get('post_tokens')}",
    )
    report.check(
        "main: compact status",
        any(s.get("compact_result") == "success" for s in statuses),
        "no status line with compact_result success:"
        f" {[(s.get('status'), s.get('compact_result')) for s in statuses]}",
        f"{[(s.get('status'), s.get('compact_result')) for s in statuses]}",
    )
    report.check(
        "main: compact result",
        any(line.get("type") == "result" for line in after[after.index(b) :]),
        "no result line after the compaction boundary: the rotation waits for it",
        "a result follows the boundary",
    )
    report.info(
        "main: compact lines",
        ", ".join(
            f"{line.get('type')}{'/' + str(line.get('subtype')) if line.get('subtype') else ''}"
            for line in after
            if line.get("type") not in ("stream_event", "rate_limit_event")
        ),
    )


def check_stop(report: Report, trace: Trace) -> None:
    """EOF on stdin is the graceful stop (lib.rs `begin_stop`), which the supervisor also
    uses to cut a turn and to stop for a rotation step: Claude Code finishes the turn in
    progress, writing its `result`, and exits 0 within the unit's SILTA_STOP_GRACE, after
    which the supervisor would kill it. The run closes stdin while the last turn's Bash
    command runs."""
    lines = trace.lines
    eof = next((i for i, line in enumerate(lines) if line["type"] == "_stdin_eof"), None)
    exits = [line for line in lines if line["type"] == "_exit"]
    if eof is None or not exits:
        return
    host = stdin_at(trace, STOP)
    ended_before = host is None or any(line.get("type") == "result" for line in lines[host:eof])
    if ended_before:
        report.warn(
            "main: turn finishes after stdin EOF",
            "the last turn had ended before stdin was closed (did the model run the command?):"
            " not judged",
        )
    else:
        results = of_type(lines[eof:], "result")
        report.check(
            "main: turn finishes after stdin EOF",
            bool(results) and results[0].get("is_error") is False,
            (
                f"the turn in progress ended with {shorten(results[0].get('result'))!r}"
                if results
                else "no result after stdin EOF: the turn in progress was dropped"
            ),
            "its result followed the EOF",
        )
    e = exits[-1]
    report.check(
        "main: exit on stdin EOF",
        e.get("code") == 0,
        f"claude exited with {e.get('code')} {e.get('seconds')} s after the start"
        + (" (killed after the grace)" if e.get("killed") else ""),
        f"exit 0, {e.get('seconds')} s after the start",
    )


def check_files(report: Report, trace: Trace, meta: dict) -> None:
    """What the run left under HOME: the transcript at `.claude/projects/<slug>/<id>.jsonl`,
    which decides whether the supervisor resumes the saved id (state.rs
    `Paths::transcript`); the plugin's log under `.cache/claude-cli-nodejs/<slug>/
    mcp-logs-plugin-<plugin>-<server>/`, which the plugin README points at and the
    supervisor prunes (state.rs `prune_cache`); and no rotation marker, since nothing in the
    main run should have made the PreCompact hook fire."""
    transcript = trace_file(trace, "transcript")
    if transcript:
        report.check(
            "main: transcript path",
            transcript.get("exists") is True,
            f"no {meta['session_id']}.jsonl under {meta.get('home', 'HOME')}/.claude/projects/*/:"
            " the supervisor could never resume",
            str(transcript.get("path")),
        )
    logs = trace_file(trace, "mcp-logs")
    if logs:
        if logs.get("exists"):
            report.ok(
                "main: mcp log path", f"{logs.get('path')}: {len(logs.get('files', []))} files"
            )
            content = logs.get("content", "")
            # The log quotes JSON inside JSON, hence the optional escapes.
            era = re.search(r'protocolEra\\?":\s*\\?"(\w+)', content)
            report.info(
                "main: mcp log",
                f"protocolEra {era.group(1) if era else '?'}; "
                + (
                    "channel notifications registered"
                    if "Channel notifications" in content
                    else "no 'Channel notifications' line"
                ),
            )
        else:
            report.warn(
                "main: mcp log path",
                f"no {logs.get('path')}: the plugin's log is elsewhere or not written (nothing"
                " breaks; the README and the cache pruning point there)",
            )
    marker = trace_file(trace, "marker")
    if marker:
        report.check(
            "main: no marker",
            marker.get("exists") is False,
            f"the PreCompact hook wrote {marker.get('path')} during the main run: an automatic"
            " compaction fired at a context this small?",
            "no automatic compaction in the main run",
        )


# --------------------------------------------------------------------------------------------------
# The resume run: the saved id comes back, and a bogus one fails the way the supervisor
# expects.
# --------------------------------------------------------------------------------------------------


def drive_resume(cfg: Config, trace: Trace, session_id: str) -> dict:
    meta = {
        "run": "resume",
        "session_id": session_id,
        "bogus": str(uuid.uuid4()),
        "window": cfg.window,
        "model": cfg.model,
    }
    trace.add({"type": "_meta", **meta})
    daemon = FakeDaemon(cfg.state / "siltad.sock", "contract-check", trace)
    run = ClaudeRun(cfg, trace, "resume", model=cfg.model, session_id=None, resume=session_id)
    try:
        # The supervisor checks the window at every start, a resume included.
        run.control(WINDOW_REQUEST, {"subtype": "get_context_usage", "detail": "summary"})
        trace.wait(lambda line: line.get("type") == "control_response", 60)
        run.send_user(RESUME)
        run.wait_result(0)
        # The stop with a background command still running, as a mind's often has.
        trace.wait(
            lambda line: line.get("type") == "system"
            and line.get("subtype") == "background_tasks_changed"
            and any(not t.get("ambient") for t in line.get("tasks", [])),
            30,
        )
        trace.wait_quiet(3, 30)
        run.close_stdin()
        run.wait_exit(cfg.stop_grace)
    finally:
        run.kill()
        daemon.close()
    bogus = ClaudeRun(
        cfg, trace, "resume-bogus", model=cfg.model, session_id=None, resume=meta["bogus"]
    )
    try:
        bogus.send_user("Reply with the single word ok.")
        bogus.wait_exit(60)
    finally:
        bogus.kill()
        trace.close()
    return meta


def check_resume(report: Report, trace: Trace, meta: dict) -> None:
    """The resume run: the saved id comes back, then a bogus id fails the way the
    supervisor expects. The trace holds both starts."""
    starts = [i for i, line in enumerate(trace.lines) if line["type"] == "_start"]
    first = trace.lines[starts[0] : starts[1]] if len(starts) > 1 else trace.lines
    second = trace.lines[starts[1] :] if len(starts) > 1 else []
    check_resumed_session(report, first, meta)
    if second:
        check_bogus_resume(report, second)


def check_resumed_session(report: Report, first: list[dict], meta: dict) -> None:
    """`--resume <id>` (lib.rs `run_once`) restores the session: the window check is
    answered as at a fresh start, the init line names the same id, and a turn runs to a
    result without an error. Stdin EOF then ends it with a background command still
    running: the supervisor kills a Claude Code that outlives SILTA_STOP_GRACE, which the
    session survives (README, known issue 2), so a wait is a warning."""
    lines = [line for line in first if not line["type"].startswith("_")]
    answers = [
        line.get("response", {})
        for line in of_type(lines, "control_response")
        if line.get("response", {}).get("request_id") == WINDOW_REQUEST
    ]
    max_tokens = (answers[0].get("response") or {}).get("maxTokens") if answers else None
    report.check(
        "resume: window",
        isinstance(max_tokens, int) and max_tokens >= meta.get("window", 0),
        (
            f"get_context_usage on --resume answered {shorten(answers[0])}"
            if answers
            else "no control_response to get_context_usage on --resume"
        )
        + f"; every restart of a mind would end (window {meta.get('window')})",
        f"maxTokens {max_tokens} >= {meta.get('window')}",
    )
    inits = of_type(lines, "system", "init")
    if report.check("resume: system init", bool(inits), "no init line on --resume"):
        report.check(
            "resume: same session_id",
            inits[0].get("session_id") == meta["session_id"],
            f"--resume {meta['session_id']} started session {inits[0].get('session_id')!r}",
            "the resumed id",
        )
    results = of_type(lines, "result")
    report.check(
        "resume: result",
        bool(results) and results[-1].get("is_error") is False,
        f"the resumed turn ended with {results[-1].get('is_error') if results else 'no result'}:"
        f" {shorten(results[-1].get('result')) if results else ''}",
        "the resumed turn answered",
    )
    exits = [line for line in first if line["type"] == "_exit"]
    if not exits:
        return
    # Running at the EOF: the last level signal before it (Claude Code stops the tasks
    # after it, with a signal of its own).
    eof = next((i for i, line in enumerate(first) if line["type"] == "_stdin_eof"), len(first))
    changed = of_type(first[:eof], "system", "background_tasks_changed")
    running = bool(changed) and any(not t.get("ambient") for t in changed[-1].get("tasks", []))
    e = exits[-1]
    if not running:
        report.check(
            "resume: exit on stdin EOF",
            e.get("code") == 0,
            f"exit {e.get('code')} (no background command was running; model-dependent)",
            f"exit 0 after {e.get('seconds')} s, no background command running",
        )
    elif e.get("code") == 0:
        report.ok(
            "resume: exit on stdin EOF",
            f"exit 0 after {e.get('seconds')} s with a background command running",
        )
    else:
        report.warn(
            "resume: exit on stdin EOF",
            f"exit {e.get('code')} after {e.get('seconds')} s"
            + (" (killed after the grace)" if e.get("killed") else "")
            + ": Claude Code waits for a background command, and the supervisor kills it"
            " after SILTA_STOP_GRACE",
        )


def check_bogus_resume(report: Report, second: list[dict]) -> None:
    """`--resume` of an id Claude Code does not know exits non-zero with `No conversation
    found with session ID` on stderr (lib.rs `NO_CONVERSATION`): on that text alone the
    supervisor drops the saved id; any other failed start keeps it."""
    stderr = " ".join(line["text"] for line in second if line["type"] == "_stderr")
    exits = [line for line in second if line["type"] == "_exit"]
    code = exits[-1].get("code") if exits else None
    report.check(
        "resume: bogus id refused",
        code not in (None, 0),
        f"--resume of an unknown id exited with {code}",
        f"exit {code}",
    )
    report.check(
        "resume: bogus id stderr",
        NO_CONVERSATION in stderr,
        f"stderr lacks {NO_CONVERSATION!r}: {shorten(stderr, 300)!r}; the supervisor would keep"
        " an id that cannot be resumed",
        f"{NO_CONVERSATION!r} on stderr",
    )


# --------------------------------------------------------------------------------------------------
# The hook run: an automatic compaction, blocked by the PreCompact hook.
# --------------------------------------------------------------------------------------------------


def drive_hook(cfg: Config, trace: Trace, session_id: str, managed_hook: bool) -> dict:
    meta = {
        "run": "hook",
        "session_id": session_id,
        "window": HOOK_WINDOW,
        "model": cfg.hook_model,
        "managed_hook": managed_hook,
    }
    trace.add({"type": "_meta", **meta})
    extra = []
    if not managed_hook:
        # On a developer's machine the hook is not in the managed settings: it is passed
        # as a settings overlay, with the matcher the deployment uses.
        settings = {
            "hooks": {
                "PreCompact": [
                    {
                        "matcher": "auto",
                        "hooks": [{"type": "command", "command": str(cfg.hook), "timeout": 30}],
                    }
                ]
            }
        }
        extra = ["--settings", json.dumps(settings)]
    daemon = FakeDaemon(cfg.state / "siltad.sock", "contract-check", trace)
    run = ClaudeRun(
        cfg,
        trace,
        "hook",
        model=cfg.hook_model,
        session_id=session_id,
        window=HOOK_WINDOW,
        extra_args=extra,
        fallback="",
    )
    try:
        text = cfg.filler.read_text(encoding="utf-8")
        trace.add(
            {
                "type": "_note",
                "text": f"filler {cfg.filler}: {len(text.split())} words, {len(text)} bytes",
            }
        )
        run.send_user(
            f"The text below is {FILLER_TITLE}, public domain, sent whole to fill the context"
            " for a test of the harness; nothing about it is asked, read it only if you want to."
            " Reply with the single word ok.\n\n" + text
        )
        first = run.wait_result(0, timeout=cfg.turn_timeout * 2)
        if first is not None:
            n = len(trace)
            run.send_user("Reply with the single word ok again.")
            run.wait_result(n, timeout=cfg.turn_timeout * 2)
            trace.wait_quiet(3, 30)
        run.close_stdin()
        run.wait_exit(cfg.stop_grace)
        record_file(trace, "marker", run.marker)
        return meta
    finally:
        run.kill()
        daemon.close()
        trace.close()


def check_hook(report: Report, trace: Trace, meta: dict) -> None:
    """The hook run: a context past the compaction threshold of a small window makes
    Claude Code compact on its own, and the PreCompact hook turns that into a rotation
    request instead."""
    lines = stdout_lines(trace)
    context = check_filler_turn(report, lines, meta)
    if context is None:
        return
    if check_compaction_attempted(report, lines, trace, meta, context):
        check_compaction_blocked(report, lines)
        check_marker(report, trace, meta)
    report_stderr(report, "hook: ", trace)


def check_filler_turn(report: Report, lines: list[dict], meta: dict) -> Optional[int]:
    """A user line carrying the whole book, about 92 000 tokens, is accepted on stdin and
    answered on the hook model, and the short second turn ends too. Returns the context size
    the first answer reported, or None when the run cannot be judged."""
    results = of_type(lines, "result")
    assistants = [line for line in of_type(lines, "assistant") if is_main(line)]
    if not report.check(
        "hook: filler turn",
        bool(results) and results[0].get("is_error") is False,
        f"the filler turn failed: {shorten(results[0].get('result')) if results else 'no result'};"
        f" a message of this size was refused, or the model ({meta['model']}) cannot serve",
    ):
        return None
    usage = assistants[0].get("message", {}).get("usage", {}) if assistants else {}
    context = sum(
        usage.get(k, 0)
        for k in ("input_tokens", "cache_read_input_tokens", "cache_creation_input_tokens")
    )
    report.info("hook: filler context", f"{context} tokens against a window of {meta['window']}")
    report.check(
        "hook: second turn",
        len(results) >= 2,
        "the second turn never ended: the blocked compaction stalled the session",
    )
    return context


def check_compaction_attempted(
    report: Report, lines: list[dict], trace: Trace, meta: dict, context: int
) -> bool:
    """CLAUDE_CODE_AUTO_COMPACT_WINDOW is honoured: with the window at its minimum and the
    context past the threshold (the window minus the output reserve minus 13 000,
    HOOK_THRESHOLD), Claude Code attempts an automatic compaction, seen as a `status`
    `compacting`, a boundary, or the hook's marker. A miss is told apart by the context
    size: above the assumed threshold it is Claude Code's threshold that moved, below it
    the book is shorter than assumed for this model's tokenizer."""
    statuses = of_type(lines, "system", "status")
    boundaries = of_type(lines, "system", "compact_boundary")
    marker = trace_file(trace, "marker")
    fired = marker is not None and marker.get("exists") is True
    attempted = any(s.get("status") == "compacting" for s in statuses) or bool(boundaries) or fired
    if context >= HOOK_THRESHOLD:
        cause = (
            f"the context is past the assumed threshold of {HOOK_THRESHOLD}, so Claude Code's"
            " threshold moved or the window is not honoured"
        )
    else:
        cause = (
            f"the context is below the assumed threshold of {HOOK_THRESHOLD}, so the filler"
            " text is too short for this model's tokenizer"
        )
    return report.check(
        "hook: automatic compaction attempted",
        attempted,
        f"no compaction after a context of {context} tokens with"
        f" CLAUDE_CODE_AUTO_COMPACT_WINDOW={meta['window']}: {cause}; the hook was never asked",
    )


def check_compaction_blocked(report: Report, lines: list[dict]) -> None:
    """The hook's exit 2 blocks the compaction: no `compact_boundary` with the trigger
    `auto`, which the supervisor would read as Claude Code compacting on its own
    (contract.rs) and which would lose the context twice, once here and once at the
    rotation. How Claude Code reports the block varies: 2.1.283 clears the `compacting`
    status without a `compact_result`; a blocked `/compact` gets `compact_result: failed`
    and a `compact_error` naming the hook (stream.rs `Event::CompactionFailed`)."""
    statuses = of_type(lines, "system", "status")
    boundaries = of_type(lines, "system", "compact_boundary")
    auto = [b for b in boundaries if (b.get("compact_metadata") or {}).get("trigger") == "auto"]
    report.check(
        "hook: no automatic compaction",
        not auto,
        f"compact_boundary with trigger auto: {[(b.get('compact_metadata') or {}) for b in auto]};"
        " the hook did not block it, and the supervisor's rotation would be pre-empted",
        "no compact_boundary with the trigger auto",
    )
    report.info(
        "hook: compact statuses",
        ", ".join(
            f"status={s.get('status')} compact_result={s.get('compact_result')}"
            + (
                f" compact_error={shorten(s.get('compact_error'), 100)!r}"
                if s.get("compact_error")
                else ""
            )
            for s in statuses
        )
        or "none",
    )


def check_marker(report: Report, trace: Trace, meta: dict) -> None:
    """The hook ran with the unit's environment (SILTA_SESSION, SILTA_ROTATE,
    STATE_DIRECTORY) and wrote `rotate-requested` in the state directory
    (deploy/silta-precompact-block): its stdin, a JSON object with `session_id`,
    `transcript_path` and `trigger` `auto`. The supervisor's rotation starts from that
    marker (rotation.rs, state.rs `Paths::marker`)."""
    marker = trace_file(trace, "marker")
    fired = marker is not None and marker.get("exists") is True
    if not report.check(
        "hook: marker written",
        fired,
        f"the hook left no {marker.get('path') if marker else 'rotate-requested'}: the hook did not"
        " run (matcher auto, SILTA_SESSION, STATE_DIRECTORY?), so the rotation would never be"
        " asked for",
    ):
        return
    try:
        content = json.loads(marker.get("content", ""))
    except json.JSONDecodeError:
        content = None
    report.check(
        "hook: marker content",
        isinstance(content, dict)
        and content.get("trigger") == "auto"
        and content.get("session_id") == meta["session_id"]
        and "transcript_path" in content,
        f"the hook's stdin was {shorten(marker.get('content'), 300)!r}; expected JSON with"
        " trigger auto, session_id and transcript_path",
        (
            f"trigger auto, session_id, transcript_path {content.get('transcript_path')}"
            if isinstance(content, dict)
            else ""
        ),
    )


# --------------------------------------------------------------------------------------------------
# The fault runs: a model Claude Code does not find, and a credential the API refuses.
# --------------------------------------------------------------------------------------------------


def drive_fallback(cfg: Config, trace: Trace, session_id: str) -> dict:
    bogus = "claude-contract-check-nonexistent"
    meta = {
        "run": "fallback",
        "session_id": session_id,
        "bogus": bogus,
        "fallback": cfg.fallback_model,
    }
    trace.add({"type": "_meta", **meta})
    daemon = FakeDaemon(cfg.state / "siltad.sock", "contract-check", trace)
    # The window check is skipped: a model Claude Code does not know gets the 200 000
    # default, which is the very thing the supervisor would refuse.
    run = ClaudeRun(cfg, trace, "fallback", model=bogus, session_id=session_id, window=200_000)
    try:
        run.send_user("Reply with the single word ok.")
        run.wait_result(0)
        run.close_stdin()
        run.wait_exit(60)
        return meta
    finally:
        run.kill()
        daemon.close()
        trace.close()


def check_fallback(report: Report, trace: Trace, meta: dict) -> None:
    """The fallback run: a model Claude Code does not find, with `--fallback-model` set,
    gives a `system model_fallback` line (stream.rs `Event::ModelFallback`) whose `trigger`
    `model_not_found` is one the supervisor ends the session on with exit 79 (contract.rs
    `FALLBACK_FATAL`, lib.rs `Run::fallback`); `original_model` and `fallback_model` name
    the two, and the turn itself runs on the fallback."""
    if not meta.get("fallback"):
        report.skip(
            "fallback: model_fallback", "no fallback model configured (SILTA_FALLBACK_MODEL)"
        )
        return
    lines = stdout_lines(trace)
    fallbacks = of_type(lines, "system", "model_fallback")
    results = of_type(lines, "result")
    if not report.check(
        "fallback: model_fallback line",
        bool(fallbacks),
        f"no system model_fallback line for the model {meta['bogus']!r}: results"
        f" {[(r.get('is_error'), shorten(r.get('result'), 120)) for r in results]}; the supervisor"
        " would not learn that the primary model cannot serve",
    ):
        return
    f = fallbacks[0]
    report.check(
        "fallback: trigger",
        f.get("trigger") == "model_not_found",
        f"trigger is {f.get('trigger')!r} (known fatal: {FALLBACK_FATAL}, outage:"
        f" {FALLBACK_OUTAGE})",
        "model_not_found",
    )
    report.check(
        "fallback: models named",
        f.get("original_model") == meta["bogus"] and f.get("fallback_model") == meta["fallback"],
        f"original_model {f.get('original_model')!r}, fallback_model"
        f" {f.get('fallback_model')!r}",
        f"{f.get('original_model')} -> {f.get('fallback_model')}",
    )
    report.check(
        "fallback: turn on the fallback",
        bool(results) and results[-1].get("is_error") is False,
        f"the turn ended with {results[-1].get('is_error') if results else 'no result'}:"
        f" {shorten(results[-1].get('result')) if results else ''}",
        "the fallback model answered",
    )


def drive_badkey(cfg: Config, trace: Trace, session_id: str) -> dict:
    meta = {"run": "badkey", "session_id": session_id}
    trace.add({"type": "_meta", **meta})
    daemon = FakeDaemon(cfg.state / "siltad.sock", "contract-check", trace)
    # An invalid API key takes precedence over any login, and one retry keeps the run
    # short (Claude Code retries a 401 ten times, about three minutes, by default).
    env = {
        "ANTHROPIC_API_KEY": "sk-ant-api03-invalid-contract-check-key",
        "CLAUDE_CODE_MAX_RETRIES": "1",
    }
    run = ClaudeRun(
        cfg, trace, "badkey", model=cfg.model, session_id=session_id, env=env, drop=AUTH_VARS
    )
    try:
        run.send_user("Reply with the single word ok.")
        run.wait_result(0, timeout=300)
        run.close_stdin()
        run.wait_exit(60)
        return meta
    finally:
        run.kill()
        daemon.close()
        trace.close()


def check_badkey(report: Report, trace: Trace, meta: dict) -> None:
    """The bad-key run: a credential the API refuses. After Claude Code's retries
    (CLAUDE_CODE_MAX_RETRIES=1 keeps them short) the turn ends with a `result` whose
    `is_error` is true and, before it, an `assistant` line Claude Code wrote itself, with
    `message.model` `<synthetic>`: the marker that keeps the supervisor from taking the
    API's error text for a model's answer and opening the channel (lib.rs `run_once`,
    stream.rs `Event::Assistant`)."""
    lines = stdout_lines(trace)
    results = of_type(lines, "result")
    if not report.check(
        "bad key: result",
        bool(results),
        "no result line within the wait: an authentication failure does not end the turn",
    ):
        return
    r = results[-1]
    report.check(
        "bad key: is_error",
        r.get("is_error") is True,
        f"the turn with an invalid key ended with is_error {r.get('is_error')!r}:"
        f" {shorten(r.get('result'))}",
        f"is_error true: {shorten(r.get('result'), 120)}",
    )
    synthetic = [
        line
        for line in of_type(lines, "assistant")
        if is_main(line) and line.get("message", {}).get("model") == "<synthetic>"
    ]
    models = sorted(
        {str(line.get("message", {}).get("model")) for line in of_type(lines, "assistant")}
    )
    report.check(
        "bad key: synthetic assistant",
        bool(synthetic),
        f"no main-line assistant line with message.model <synthetic> (models seen: {models});"
        " the supervisor would take the API's error text for a model's answer and open the"
        " channel",
        "message.model <synthetic> marks the API's error",
    )
    retries = of_type(lines, "system", "api_retry")
    report.info(
        "bad key: api_retry lines",
        f"{len(retries)}"
        + (
            f", first: status {retries[0].get('error_status')} {retries[0].get('error')}"
            if retries
            else ""
        ),
    )


# --------------------------------------------------------------------------------------------------
# Putting it together.
# --------------------------------------------------------------------------------------------------

RUNS = {
    "main": (drive_main, check_main),
    "resume": (drive_resume, check_resume),
    "hook": (drive_hook, check_hook),
    "fallback": (drive_fallback, check_fallback),
    "badkey": (drive_badkey, check_badkey),
}


def replay(report: Report, directory: Path) -> Optional[str]:
    version = None
    found = False
    for name, (_, check) in RUNS.items():
        path = directory / f"{name}.jsonl"
        if not path.is_file():
            continue
        found = True
        trace = Trace.load(path)
        meta = next((line for line in trace.lines if line["type"] == "_meta"), {})
        result = check(report, trace, meta)
        note_cost(report, name, trace)
        if name == "main":
            version = result
    if not found:
        raise SystemExit(
            f"no <run>.jsonl traces in {directory} (expected some of {', '.join(RUNS)})"
        )
    return version


def live(report: Report, cfg: Config) -> Optional[str]:
    version = check_static(report, cfg)
    if report.failed():
        report.info("aborting", "the preconditions failed; no run")
        return version
    managed_hook, hook_skip = hook_plan(cfg)
    if cfg.service:
        clear_workspace_state(cfg)
    install = PluginInstall(cfg, report)
    session_ids: list[str] = []
    try:
        if not install.install():
            report.info("aborting", "the plugin is not installed; no run")
            return version
        main_id = str(uuid.uuid4())
        session_ids.append(main_id)
        report.info("logs", str(cfg.logs))
        report.running("main", "a fresh session with the channel, some ten turns")
        trace = Trace(cfg.logs / "main.jsonl")
        seen = check_main(report, trace, drive_main(cfg, trace, main_id))
        note_cost(report, "main", trace)
        version = seen or version
        if "resume" in cfg.skip:
            report.skip("resume", "--skip")
            report.costs["resume"] = None
        else:
            report.running("resume", "the main session resumed, then an unknown id")
            trace = Trace(cfg.logs / "resume.jsonl")
            check_resume(report, trace, drive_resume(cfg, trace, main_id))
            note_cost(report, "resume", trace)
        if "hook" in cfg.skip or hook_skip:
            report.skip("hook", hook_skip or "--skip")
            report.costs["hook"] = None
        else:
            sid = str(uuid.uuid4())
            session_ids.append(sid)
            report.running("hook", "two turns over a whole book on the hook model")
            trace = Trace(cfg.logs / "hook.jsonl")
            check_hook(report, trace, drive_hook(cfg, trace, sid, managed_hook))
            note_cost(report, "hook", trace)
        if "fallback" in cfg.skip:
            report.skip("fallback", "--skip")
            report.costs["fallback"] = None
        else:
            sid = str(uuid.uuid4())
            session_ids.append(sid)
            report.running("fallback", "a model Claude Code does not find")
            trace = Trace(cfg.logs / "fallback.jsonl")
            check_fallback(report, trace, drive_fallback(cfg, trace, sid))
            note_cost(report, "fallback", trace)
        if "badkey" in cfg.skip:
            report.skip("bad key", "--skip")
            report.costs["badkey"] = None
        else:
            sid = str(uuid.uuid4())
            session_ids.append(sid)
            report.running("badkey", "a credential the API refuses")
            trace = Trace(cfg.logs / "badkey.jsonl")
            check_badkey(report, trace, drive_badkey(cfg, trace, sid))
            note_cost(report, "badkey", trace)
    finally:
        install.cleanup()
        cleanup_traces(cfg, session_ids)
    return version


def main() -> int:
    parser = argparse.ArgumentParser(
        description=__doc__.split("\n\n")[0],
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=(
            "The environment of a silta-session unit is honoured: CLAUDE_BIN, SILTA_CLAUDE_BIN,"
            " CREDENTIALS_DIRECTORY, STATE_DIRECTORY, HOME."
        ),
    )
    parser.add_argument(
        "--claude",
        help=(
            "the Claude Code binary (default: $CLAUDE_BIN, claude on PATH,"
            " /opt/claude/.local/bin/claude)"
        ),
    )
    parser.add_argument(
        "--plugin-bin",
        help=(
            "the silta-claude binary (default: $SILTA_CLAUDE_BIN, the repository's target/,"
            " silta-claude on PATH)"
        ),
    )
    parser.add_argument(
        "--marketplace",
        help=(
            "the marketplace directory (default: the repository's assistant/marketplace, else"
            " /usr/share/silta/marketplace)"
        ),
    )
    parser.add_argument(
        "--unit",
        help=(
            "the silta-session@.service to read the model, window and knobs from (default: the"
            " repository's deploy/ copy, else the installed unit)"
        ),
    )
    parser.add_argument("--model", help="the main model (default: the unit's SILTA_MODEL)")
    parser.add_argument(
        "--effort",
        help=(
            "the effort for every run (default: low; the value is not part of the contract, the"
            " flag is)"
        ),
    )
    parser.add_argument(
        "--fallback-model", help="the fallback model (default: the unit's SILTA_FALLBACK_MODEL)"
    )
    parser.add_argument(
        "--window",
        type=int,
        help=(
            "the window the model must be measured against (default: the unit's"
            " CLAUDE_CODE_AUTO_COMPACT_WINDOW)"
        ),
    )
    parser.add_argument(
        "--hook-model",
        default=DEFAULT_HOOK_MODEL,
        help=(
            "the model of the hook run, which reads about 106 000 tokens twice (default:"
            f" {DEFAULT_HOOK_MODEL})"
        ),
    )
    parser.add_argument(
        "--credentials",
        help=(
            "a directory laid out like the unit's credentials (auth_oauth-token or auth_api-key);"
            " default: $CREDENTIALS_DIRECTORY, else the login of the calling user"
        ),
    )
    parser.add_argument(
        "--home", help="with --credentials: the HOME Claude Code runs with (default: $HOME)"
    )
    parser.add_argument("--logs", help="where the traces go (default: <state>/logs/<time>)")
    parser.add_argument(
        "--skip",
        help=(
            "runs to skip, comma-separated: resume,hook,fallback,badkey (hook is the slow one: two"
            " turns over a context of about 106 000 tokens on the hook model)"
        ),
    )
    parser.add_argument(
        "--turn-timeout",
        type=float,
        default=240,
        help="seconds to wait for a turn to end (default: 240)",
    )
    parser.add_argument(
        "--claude-arg",
        action="append",
        metavar="ARG",
        help=(
            "an argument added to every run of Claude Code, repeatable; {logs} and {run} in it"
            " become the logs directory and the run's name, so"
            " --claude-arg=--debug-file={logs}/{run}-debug.log keeps Claude Code's debug log of"
            " each run next to its trace (default: $SILTA_CHECK_CLAUDE_ARGS, split like a shell"
            " command line)"
        ),
    )
    parser.add_argument(
        "--keep",
        action="store_true",
        help="keep the temporary state directory of a developer-machine run",
    )
    parser.add_argument(
        "-q",
        "--quiet",
        action="store_true",
        help=(
            "print only failures, warnings, skips and the summary (under systemd, journalctl -p"
            " warning does the same without it)"
        ),
    )
    parser.add_argument(
        "--replay",
        metavar="DIR",
        help="run the assertions over the traces saved in DIR instead of running Claude Code",
    )
    args = parser.parse_args()
    report = Report(quiet=args.quiet)
    if args.replay:
        version = replay(report, Path(args.replay))
        report.summary(version)
        return 1 if report.failed() else 0
    cfg = configure(args)
    emit(
        f"contract check of {cfg.claude} with {cfg.plugin_bin}, model {cfg.model}, window"
        f" {cfg.window}, {'the unit' if cfg.service else 'the developer'}'s login, state"
        f" {cfg.state}"
    )
    try:
        version = live(report, cfg)
    finally:
        if not cfg.service and not cfg.keep and not report.failed():
            shutil.rmtree(cfg.state, ignore_errors=True)
        elif not cfg.service:
            emit(f"state and traces kept in {cfg.state}")
    report.summary(version)
    return 1 if report.failed() else 0


if __name__ == "__main__":
    # A reader that stops early (`| head`) ends the script quietly, as it would a C program.
    signal.signal(signal.SIGPIPE, signal.SIG_DFL)
    sys.exit(main())
