# Rust
target/

# Claude Code local state
.claude/settings.local.json
**/.claude/settings.local.json
CLAUDE.local.md

# Dev session workspace: runtime files (inbox, out, notes, memory); only the plugin
# enablement is tracked
dev/workspace/*
!dev/workspace/.claude/
dev/workspace/.claude/*
!dev/workspace/.claude/settings.json

# Secrets and host-specific config: only *.example files are tracked
*.env
*.secret
deploy/*.toml
!deploy/*.example.toml

# Editors and OS
.idea/
.vscode/
*.swp
.DS_Store

# Dev environment: host-specific config with test-server passwords, and runtime state
dev/*.toml
!dev/*.example.toml
dev/state/
